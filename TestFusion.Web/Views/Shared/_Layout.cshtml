<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>TestFusion</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/css/site.css"/>
    <link rel="stylesheet" href="~/css/nav-bar.css"/>
</head>
<body>
    <header>
        <nav class="nav-bar">
            <a id="nav-app-name" href="">TestFusion</a>
            <div>
                <ul id="nav-subbar">
                    <li class="nav-item">
                        <a id="nav-link-analysis" class="nav-link" href="">Analyse maken</a>
                    </li>
                    <li class="nav-item">
                        <a id="nav-link-history" class="nav-link" href="">Historie</a>
                    </li>
                </ul>
                    
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/js/site.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
