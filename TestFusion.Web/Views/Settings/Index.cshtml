@using Microsoft.Extensions.Localization
@using TestFusion.Core
@using TestFusion.Core.Enums
@using TestFusion.Core.Models
@inject IStringLocalizer<SharedResource> Localizer
@model TestFusion.Core.Models.WebModels.SettingsViewModel

@{
    ViewData["Title"] = Localizer["PageTitleSettings"];

    var successDuration = 5000;

    if (TempData["SuccessDuration"] is int duration)
    {
        successDuration = duration;
    }
}

<link rel="stylesheet"
      href="~/css/settings.css"
      asp-append-version="true" />

<div class="settings-page">
    <div class="settings-header">
        <h2>@Localizer["PageTitleSettings"]</h2>
        <p>@Localizer["SettingsDescription"]@Localizer["SymbolDot"]</p>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="settings-message settings-message-success settings-message-temporary"
             data-duration="@successDuration"
             role="status"
             aria-live="polite">
            <div class="settings-message-content">
                <span>@TempData["Success"]</span>

                <button type="button"
                        class="settings-message-close"
                        aria-label="@Localizer["SettingsMessageClose"]">
                    @Localizer["SymbolCross"]
                </button>
            </div>

            <div class="settings-message-progress"></div>
        </div>
    }

    <form asp-action="Index"
          method="post"
          class="settings-form"
          novalidate>
        @Html.AntiForgeryToken()

        <input asp-for="ReturnUrl"
               type="hidden" />

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="settings-message settings-message-error settings-message-temporary"
                 data-duration="@successDuration"
                 role="alert"
                 aria-live="assertive">
                <div class="settings-message-content">
                    <div asp-validation-summary="All"></div>

                    <button type="button"
                            class="settings-message-close"
                            aria-label="@Localizer["SettingsMessageClose"]">
                        @Localizer["SymbolCross"]
                    </button>
                </div>

                <div class="settings-message-progress"></div>
            </div>
        }

        <div class="settings-layout">
            <aside class="settings-sidebar">
                <nav class="settings-navigation">
                    <a href="#settings-analysis"
                       class="settings-navigation-main active">
                        @Localizer["SettingsSectionAnalysis"]
                    </a>

                    <a href="#settings-comparison"
                       class="settings-navigation-sub">
                        @Localizer["SettingsSectionComparison"]
                    </a>

                    <a href="#settings-pdf-export"
                       class="settings-navigation-sub">
                        @Localizer["SettingsSectionPdfExport"]
                    </a>

                    <a href="#settings-navigation"
                       class="settings-navigation-main">
                        @Localizer["SettingsSectionNavigation"]
                    </a>

                    <a href="#settings-carbonx"
                       class="settings-navigation-main">
                        @Localizer["SettingsSectionCarbonX"]
                    </a>
                </nav>

                <div class="settings-actions">
                    <button type="submit"
                            id="settings-save"
                            class="btn"
                            disabled>
                        @Localizer["ButtonSave"]
                    </button>

                    @if (!string.IsNullOrWhiteSpace(Model.ReturnUrl))
                    {
                        <a href="@Model.ReturnUrl"
                           class="btn settings-button-secondary">
                            @Localizer["ButtonBack"]
                        </a>
                    }
                    else
                    {
                        <a asp-controller="Home"
                           asp-action="Index"
                           class="btn settings-button-secondary">
                            @Localizer["ButtonBack"]
                        </a>
                    }

                    <div class="settings-reset-area">
                        <button type="submit"
                                asp-action="ResetToDefaults"
                                class="btn settings-button-reset"
                                formnovalidate
                                data-confirm="@Localizer["SettingsResetDefaultsConfirm", Localizer["SymbolQuestionmark"], Localizer["SymbolDot"]]">
                            @Localizer["ButtonResetDefaults"]
                        </button>
                    </div>
                </div>
            </aside>

            <div class="settings-content">
                <section id="settings-analysis"
                         class="settings-section">
                    <div class="settings-section-header">
                        <h2>@Localizer["SettingsSectionAnalysis"]</h2>
                        <p>@Localizer["SettingsAnalysisDescription"]@Localizer["SymbolDot"]</p>
                    </div>

                    <div class="settings-section-content">
                        <div id="settings-comparison"
                             class="settings-subsection">
                            <div class="settings-subsection-header">
                                <h3>@Localizer["SettingsSectionComparison"]</h3>
                                <p>@Localizer["SettingsComparisonDescription"]@Localizer["SymbolDot"]</p>
                            </div>

                            <div class="settings-subsection-content">
                                <label class="settings-checkbox">
                                    <input asp-for="GroupTestsByBaseName" />

                                    <span>
                                        <strong>@Localizer["SettingsGroupTestsByBaseName"]</strong>
                                        <small>@Localizer["SettingsGroupTestsByBaseNameDescription"]@Localizer["SymbolDot"]</small>
                                    </span>
                                </label>

                                <label class="settings-checkbox">
                                    <input asp-for="ShowFullySkippedTests" />

                                    <span>
                                        <strong>@Localizer["SettingsShowFullySkippedTests"]</strong>
                                        <small>@Localizer["SettingsShowFullySkippedTestsDescription"]@Localizer["SymbolDot"]</small>
                                    </span>
                                </label>

                                <div class="settings-option-group">
                                    <label class="settings-checkbox">
                                        <input asp-for="AnalysisValidationEnabled"
                                               id="analysis-validation-enabled"
                                               aria-controls="analysis-validation-options" />

                                        <span>
                                            <strong>@Localizer["SettingsAnalysisValidationEnabled"]</strong>
                                            <small>@Localizer["SettingsAnalysisValidationEnabledDescription"]@Localizer["SymbolDot"]</small>
                                        </span>
                                    </label>

                                    <div id="analysis-validation-options"
                                         class="settings-option-group-child">
                                        <div class="settings-field">
                                            <label asp-for="AnalysisValidationDisplayMode">
                                                @Localizer["SettingsAnalysisValidationDisplayMode"]
                                            </label>

                                            <select asp-for="AnalysisValidationDisplayMode"
                                                    id="analysis-validation-display-mode"
                                                    class="form-select"
                                                    aria-describedby="analysis-validation-display-description">
                                                @foreach (var displayMode in Enum.GetValues<AnalysisValidationDisplayModeEnum>())
                                                {
                                                    <option value="@displayMode">
                                                        @Localizer[$"AnalysisValidationDisplayMode{displayMode}"]
                                                    </option>
                                                }
                                            </select>

                                            <input type="hidden"
                                                   id="analysis-validation-display-mode-hidden"
                                                   name="AnalysisValidationDisplayMode"
                                                   value="@Model.AnalysisValidationDisplayMode"
                                                   disabled />

                                            <small id="analysis-validation-display-description">
                                                @Localizer["SettingsAnalysisValidationDisplayModeDescription"]@Localizer["SymbolDot"]
                                            </small>
                                        </div>
                                    </div>
                                </div>

                                <div class="settings-subgroup">
                                    <div class="settings-subgroup-header">
                                        <h4>@Localizer["SettingsSectionCustomerGrouping"]</h4>
                                        <p>@Localizer["SettingsCustomerGroupingDescription"]@Localizer["SymbolDot"]</p>
                                    </div>

                                    <div class="settings-subgroup-content">
                                        <label class="settings-checkbox">
                                            <input asp-for="MatchCustomerName" />

                                            <span>
                                                <strong>@Localizer["SettingsMatchCustomerName"]</strong>
                                                <small>@Localizer["SettingsMatchCustomerNameDescription"]@Localizer["SymbolDot"]</small>
                                            </span>
                                        </label>

                                        <label class="settings-checkbox">
                                            <input asp-for="MatchCustomerPhone" />

                                            <span>
                                                <strong>@Localizer["SettingsMatchCustomerPhone"]</strong>
                                                <small>@Localizer["SettingsMatchCustomerPhoneDescription"]@Localizer["SymbolDot"]</small>
                                            </span>
                                        </label>

                                        <label class="settings-checkbox">
                                            <input asp-for="MatchCustomerMail" />

                                            <span>
                                                <strong>@Localizer["SettingsMatchCustomerMail"]</strong>
                                                <small>@Localizer["SettingsMatchCustomerMailDescription"]@Localizer["SymbolDot"]</small>
                                            </span>
                                        </label>

                                        <label class="settings-checkbox">
                                            <input asp-for="MatchCustomerNotes" />

                                            <span>
                                                <strong>@Localizer["SettingsMatchCustomerNotes"]</strong>
                                                <small>@Localizer["SettingsMatchCustomerNotesDescription"]@Localizer["SymbolDot"]</small>
                                            </span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div id="settings-pdf-export"
                             class="settings-subsection">
                            <div class="settings-subsection-header">
                                <h3>@Localizer["SettingsSectionPdfExport"]</h3>
                                <p>@Localizer["SettingsPdfDescription"]@Localizer["SymbolDot"]</p>
                            </div>

                            <div class="settings-subsection-content">
                                <div class="settings-field">
                                    <label asp-for="PdfDefaultLayoutMode">
                                        @Localizer["SettingsPdfDefaultLayout"]
                                    </label>

                                    <select asp-for="PdfDefaultLayoutMode"
                                            class="form-select">
                                        @foreach (var layoutMode in Enum.GetValues<PdfLayoutModeEnum>())
                                        {
                                            <option value="@layoutMode">
                                                @Localizer[$"PDFOption{layoutMode}"]
                                            </option>
                                        }
                                    </select>

                                    <small>@Localizer["SettingsPdfDefaultLayoutDescription"]@Localizer["SymbolDot"]</small>
                                </div>

                                <div class="settings-field">
                                    <label asp-for="PdfMaxInjectorsPerPage">
                                        @Localizer["SettingsPdfMaxInjectorsPerPage"]
                                    </label>

                                    <input asp-for="PdfMaxInjectorsPerPage"
                                           type="number"
                                           min="@ApplicationSettings.MinPdfInjectorsPerPage"
                                           max="@ApplicationSettings.MaxPdfInjectorsPerPage" />

                                    <span asp-validation-for="PdfMaxInjectorsPerPage"
                                          class="settings-field-error">
                                    </span>

                                    <small>
                                        @Localizer[
                                            "SettingsPdfMaxInjectorsPerPageDescription",
                                            ApplicationSettings.MinPdfInjectorsPerPage,
                                            ApplicationSettings.MaxPdfInjectorsPerPage
                                        ]@Localizer["SymbolDot"]
                                    </small>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <section id="settings-navigation"
                         class="settings-section">
                    <div class="settings-section-header">
                        <h2>@Localizer["SettingsSectionNavigation"]</h2>
                        <p>@Localizer["SettingsNavigationDescription"]@Localizer["SymbolDot"]</p>
                    </div>

                    <div class="settings-section-content">
                        <div class="settings-navigation-table">
                            <div class="settings-navigation-row settings-navigation-row-header">
                                <span>@Localizer["Page"]</span>
                                <span>@Localizer["SymbolArrowLeft"] @Localizer["DebugNavigationLeft"]</span>
                                <span>@Localizer["SymbolArrowUp"] @Localizer["DebugNavigationTop"]</span>
                                <span>@Localizer["SymbolArrowUpLeft"] @Localizer["DebugNavigationTopLeft"]</span>
                            </div>

                            @foreach (var navigationPage in Model.NavigationPages
                                .Where(page => !page.Key.StartsWith("Debug/", StringComparison.OrdinalIgnoreCase)))
                            {
                                <div class="settings-navigation-row">
                                    <strong>@navigationPage.Key</strong>

                                    <label class="settings-navigation-toggle">
                                        @Html.CheckBox(
                                            $"NavigationPages[{navigationPage.Key}].ShowBackToLeft",
                                            navigationPage.Value.ShowBackToLeft)
                                        <span>@Localizer["SymbolArrowLeft"]</span>
                                    </label>

                                    <label class="settings-navigation-toggle">
                                        @Html.CheckBox(
                                            $"NavigationPages[{navigationPage.Key}].ShowBackToTop",
                                            navigationPage.Value.ShowBackToTop)
                                        <span>@Localizer["SymbolArrowUp"]</span>
                                    </label>

                                    <label class="settings-navigation-toggle">
                                        @Html.CheckBox(
                                            $"NavigationPages[{navigationPage.Key}].ShowBackToStart",
                                            navigationPage.Value.ShowBackToStart)
                                        <span>@Localizer["SymbolArrowUpLeft"]</span>
                                    </label>
                                </div>
                            }
                        </div>
                    </div>
                </section>

                <section id="settings-carbonx"
                         class="settings-section">
                    <div class="settings-section-header">
                        <h2>@Localizer["SettingsSectionCarbonX"]</h2>
                        <p>@Localizer["SettingsCarbonXDescription"]@Localizer["SymbolDot"]</p>
                    </div>

                    <div class="settings-section-content">
                        <div class="settings-field">
                            <label asp-for="CarbonXEmail">
                                @Localizer["SettingsCarbonXEmail"]
                            </label>

                            <input asp-for="CarbonXEmail"
                                   type="email"
                                   autocomplete="off" />

                            <span asp-validation-for="CarbonXEmail"
                                  class="settings-field-error">
                            </span>
                        </div>

                        <div class="settings-field">
                            <label asp-for="NewCarbonXPassword">
                                @Localizer["SettingsCarbonXPassword"]
                            </label>

                            <input asp-for="NewCarbonXPassword"
                                   type="password"
                                   autocomplete="new-password"
                                   placeholder="@Localizer["SettingsCarbonXNewPasswordPlaceholder"]" />

                            <span asp-validation-for="NewCarbonXPassword"
                                  class="settings-field-error">
                            </span>

                            @if (Model.HasCarbonXPassword)
                            {
                                <small>@Localizer["SettingsCarbonXPasswordStoredDescription"]@Localizer["SymbolDot"]</small>
                            }
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/settings.js" asp-append-version="true"></script>
}