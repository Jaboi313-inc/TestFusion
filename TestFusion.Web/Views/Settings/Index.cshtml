@using Microsoft.Extensions.Localization
@using TestFusion.Core
@inject IStringLocalizer<SharedResource> Localizer
@model TestFusion.Core.Models.WebModels.SettingsViewModel

@{
    ViewData["Title"] = Localizer["PageTitleSettings"];

    var successDuration = 5000;

    if (TempData["SuccessDuration"] is int duration)
    {
        successDuration = duration;
    }
}

<link rel="stylesheet"
      href="~/css/settings.css"
      asp-append-version="true" />

<div class="settings-page">
    <div class="settings-header">
        <h2>@Localizer["PageTitleSettings"]</h2>
        <p>@Localizer["SettingsDescription"]</p>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="settings-message settings-message-success settings-message-temporary"
             data-duration="@successDuration"
             role="status"
             aria-live="polite">
            <div class="settings-message-content">
                <span>@TempData["Success"]</span>

                <button type="button"
                        class="settings-message-close"
                        aria-label="@Localizer["SettingsMessageClose"]">
                    @Localizer["SymbolCross"]
                </button>
            </div>

            <div class="settings-message-progress"></div>
        </div>
    }

    <form asp-action="Index"
          method="post"
          class="settings-form">
        @Html.AntiForgeryToken()

        <input asp-for="ReturnUrl"
               type="hidden" />

        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="All"
                 class="settings-validation">
            </div>
        }

        <div class="settings-layout">
            <aside class="settings-sidebar">
                <nav class="settings-navigation">
                    <a href="#settings-analysis"
                       class="active">
                        @Localizer["SettingsSectionAnalysis"]
                    </a>

                    <a href="#settings-customer">
                        @Localizer["SettingsSectionCustomerGrouping"]
                    </a>

                    <a href="#settings-pdf">
                        @Localizer["SettingsSectionPdf"]
                    </a>

                    <a href="#settings-navigation">
                        @Localizer["SettingsSectionNavigation"]
                    </a>

                    <a href="#settings-carbonx">
                        @Localizer["SettingsSectionCarbonX"]
                    </a>
                </nav>

                <div class="settings-actions">
                    <button type="submit"
                            id="settings-save"
                            class="btn"
                            disabled>
                        @Localizer["ButtonSave"]
                    </button>

                    @if (!string.IsNullOrWhiteSpace(Model.ReturnUrl))
                    {
                        <a href="@Model.ReturnUrl"
                           class="btn settings-button-secondary">
                            @Localizer["ButtonBack"]
                        </a>
                    }
                    else
                    {
                        <a asp-controller="Home"
                           asp-action="Index"
                           class="btn settings-button-secondary">
                            @Localizer["ButtonBack"]
                        </a>
                    }

                    <div class="settings-reset-area">
                        <button type="submit"
                                asp-action="ResetToDefaults"
                                class="btn settings-button-reset"
                                formnovalidate
                                data-confirm="@Localizer["SettingsResetDefaultsConfirm"]">
                            @Localizer["ButtonResetDefaults"]
                        </button>
                    </div>
                </div>
            </aside>

            <div class="settings-content">
                <section id="settings-analysis"
                         class="settings-section">
                    <div class="settings-section-header">
                        <h2>@Localizer["SettingsSectionAnalysis"]</h2>
                        <p>@Localizer["SettingsAnalysisDescription"]</p>
                    </div>

                    <div class="settings-section-content">
                        <label class="settings-checkbox">
                            <input asp-for="GroupTestsByBaseName" />

                            <span>
                                <strong>@Localizer["SettingsGroupTestsByBaseName"]</strong>
                                <small>@Localizer["SettingsGroupTestsByBaseNameDescription"]</small>
                            </span>
                        </label>
                    </div>
                </section>

                <section id="settings-customer"
                         class="settings-section">
                    <div class="settings-section-header">
                        <h2>@Localizer["SettingsSectionCustomerGrouping"]</h2>
                        <p>@Localizer["SettingsCustomerGroupingDescription"]</p>
                    </div>

                    <div class="settings-section-content">
                        <label class="settings-checkbox">
                            <input asp-for="MatchCustomerName" />

                            <span>
                                <strong>@Localizer["SettingsMatchCustomerName"]</strong>
                                <small>@Localizer["SettingsMatchCustomerNameDescription"]</small>
                            </span>
                        </label>

                        <label class="settings-checkbox">
                            <input asp-for="MatchCustomerPhone" />

                            <span>
                                <strong>@Localizer["SettingsMatchCustomerPhone"]</strong>
                                <small>@Localizer["SettingsMatchCustomerPhoneDescription"]</small>
                            </span>
                        </label>

                        <label class="settings-checkbox">
                            <input asp-for="MatchCustomerMail" />

                            <span>
                                <strong>@Localizer["SettingsMatchCustomerMail"]</strong>
                                <small>@Localizer["SettingsMatchCustomerMailDescription"]</small>
                            </span>
                        </label>

                        <label class="settings-checkbox">
                            <input asp-for="MatchCustomerNotes" />

                            <span>
                                <strong>@Localizer["SettingsMatchCustomerNotes"]</strong>
                                <small>@Localizer["SettingsMatchCustomerNotesDescription"]</small>
                            </span>
                        </label>
                    </div>
                </section>

                <section id="settings-pdf"
                         class="settings-section">
                    <div class="settings-section-header">
                        <h2>@Localizer["SettingsSectionPdf"]</h2>
                        <p>@Localizer["SettingsPdfDescription"]</p>
                    </div>

                    <div class="settings-section-content">
                        <div class="settings-field">
                            <label asp-for="PdfMaxInjectorsPerPage">
                                @Localizer["SettingsPdfMaxInjectorsPerPage"]
                            </label>

                            <input asp-for="PdfMaxInjectorsPerPage"
                                   type="number"
                                   min="1"
                                   max="10" />

                            <span asp-validation-for="PdfMaxInjectorsPerPage"
                                  class="settings-field-error">
                            </span>

                            <small>@Localizer["SettingsPdfMaxInjectorsPerPageDescription"]</small>
                        </div>
                    </div>
                </section>

                <section id="settings-navigation"
                         class="settings-section">
                    <div class="settings-section-header">
                        <h2>@Localizer["SettingsSectionNavigation"]</h2>
                        <p>@Localizer["SettingsNavigationDescription"]</p>
                    </div>

                    <div class="settings-section-content">
                        <div class="settings-navigation-table">
                            <div class="settings-navigation-row settings-navigation-row-header">
                                <span>@Localizer["Page"]</span>
                                <span>@Localizer["SymbolArrowLeft"] @Localizer["DebugNavigationLeft"]</span>
                                <span>@Localizer["SymbolArrowUp"] @Localizer["DebugNavigationTop"]</span>
                                <span>@Localizer["SymbolArrowUpLeft"] @Localizer["DebugNavigationTopLeft"]</span>
                            </div>

                            @foreach (var navigationPage in Model.NavigationPages
                                .Where(page => !page.Key.StartsWith("Debug/", StringComparison.OrdinalIgnoreCase)))
                            {
                                <div class="settings-navigation-row">
                                    <strong>@navigationPage.Key</strong>

                                    <label class="settings-navigation-toggle">
                                        @Html.CheckBox(
                                            $"NavigationPages[{navigationPage.Key}].ShowBackToLeft",
                                            navigationPage.Value.ShowBackToLeft)
                                        <span>@Localizer["SymbolArrowLeft"]</span>
                                    </label>

                                    <label class="settings-navigation-toggle">
                                        @Html.CheckBox(
                                            $"NavigationPages[{navigationPage.Key}].ShowBackToTop",
                                            navigationPage.Value.ShowBackToTop)
                                        <span>@Localizer["SymbolArrowUp"]</span>
                                    </label>

                                    <label class="settings-navigation-toggle">
                                        @Html.CheckBox(
                                            $"NavigationPages[{navigationPage.Key}].ShowBackToStart",
                                            navigationPage.Value.ShowBackToStart)
                                        <span>@Localizer["SymbolArrowUpLeft"]</span>
                                    </label>
                                </div>
                            }
                        </div>
                    </div>
                </section>

                <section id="settings-carbonx"
                         class="settings-section">
                    <div class="settings-section-header">
                        <h2>@Localizer["SettingsSectionCarbonX"]</h2>
                        <p>@Localizer["SettingsCarbonXDescription"]</p>
                    </div>

                    <div class="settings-section-content">
                        <div class="settings-field">
                            <label asp-for="CarbonXEmail">
                                @Localizer["SettingsCarbonXEmail"]
                            </label>

                            <input asp-for="CarbonXEmail"
                                   type="email"
                                   autocomplete="off" />

                            <span asp-validation-for="CarbonXEmail"
                                  class="settings-field-error">
                            </span>
                        </div>

                        <div class="settings-field">
                            <label asp-for="NewCarbonXPassword">
                                @Localizer["SettingsCarbonXPassword"]
                            </label>

                            <input asp-for="NewCarbonXPassword"
                                   type="password"
                                   autocomplete="new-password"
                                   placeholder="@Localizer["SettingsCarbonXNewPasswordPlaceholder"]" />

                            <span asp-validation-for="NewCarbonXPassword"
                                  class="settings-field-error">
                            </span>

                            @if (Model.HasCarbonXPassword)
                            {
                                <small>
                                    @Localizer["SettingsCarbonXPasswordStoredDescription"]
                                </small>
                            }
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/settings.js" asp-append-version="true"></script>
}
