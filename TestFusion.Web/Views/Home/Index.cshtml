@using System.Globalization
@using Microsoft.Extensions.Localization
@using TestFusion.Core
@inject IStringLocalizer<SharedResource> Localizer

@{
    ViewData["Title"] = Localizer["PageTitelHome"];
}

@model List<TestFusion.Core.Models.TestListItemModel>

<link rel="stylesheet" href="~/css/site.css" />
<link rel="stylesheet" href="~/css/analysis.css" />

<form id="refresh-form"
      asp-controller="Home"
      asp-action="Refresh"
      method="post">
</form>

<form asp-controller="Analysis"
      asp-action="Generate"
      method="post">

    <div id="top-bar">

        <div class="top-bar-left">
            <h2>@Localizer["TestResultsOverview"]</h2>

            <button type="submit"
                    form="refresh-form"
                    class="btn">
                @Localizer["ButtonRefresh"]
            </button>
        </div>

        <div class="top-bar-right">

            <button type="button"
                    id="clear-selected"
                    class="btn"
                    disabled>
                @Localizer["ButtonClearSelected"]
            </button>

            <button type="submit"
                    id="generate-analysis"
                    class="btn"
                    disabled>
                @Localizer["ButtonGenerateAnalysis"]
            </button>

        </div>

    </div>

    <div class="list">

        <div class="list-row header">
            <span></span>
            <span>@Localizer["InjectorPartNumber"]</span>
            <span>@Localizer["InjectorBrand"]</span>
            <span>@Localizer["InjectorType"]</span>
            <span>@Localizer["InjectorDateTime"]</span>
        </div>

        @foreach (var item in Model)
        {
            <div class="list-row">

                <span class="selection-cell">

                    <input type="checkbox"
                           name="selectedIds"
                           value="@item.Id"
                           data-partnumber="@item.PartNumber">

                    <button type="button"
                            class="select-all-same btn"
                            data-partnumber="@item.PartNumber"
                            style="display: none;">
                        @Localizer["ButtonSelectAllSamePartNumber"]
                    </button>

                </span>

                <span>@item.PartNumber</span>
                <span>@item.PartBrand</span>
                <span>@item.PartType</span>
                <span>@item.DateTime.ToString("dd-MM-yyyy HH:mm")</span>

            </div>
        }

    </div>

</form>

<script>
    let selectedPartNumber = null;

    const checkboxes = document.querySelectorAll(
        'input[type="checkbox"][name="selectedIds"]'
    );

    const selectAllSameButtons =
        document.querySelectorAll('.select-all-same');

    const clearSelectedButton =
        document.getElementById('clear-selected');

    const generateAnalysisButton =
        document.getElementById('generate-analysis');


    function updateSelection() {

        const selected = Array.from(checkboxes)
            .filter(cb => cb.checked);

        // Eerst alle "selecteer alles" knoppen verbergen
        selectAllSameButtons.forEach(button => {
            button.style.display = 'none';
        });


        // Niets geselecteerd
        if (selected.length === 0) {

            selectedPartNumber = null;

            generateAnalysisButton.disabled = true;
            clearSelectedButton.disabled = true;

            return;
        }


        clearSelectedButton.disabled = false;


        // Alle unieke partnummers van geselecteerde regels
        const partNumbers = [
            ...new Set(
                selected.map(cb => cb.dataset.partnumber)
            )
        ];


        // Dit zou normaal niet mogen voorkomen,
        // maar voor de zekerheid
        if (partNumbers.length !== 1) {

            generateAnalysisButton.disabled = true;

            return;
        }


        selectedPartNumber = partNumbers[0];

        generateAnalysisButton.disabled = false;


        // Alle checkboxes met hetzelfde partnummer
        const samePartNumberCheckboxes =
            Array.from(checkboxes)
                .filter(cb =>
                    cb.dataset.partnumber === selectedPartNumber
                );


        // Controleer of ze allemaal al geselecteerd zijn
        const allSelected =
            samePartNumberCheckboxes.every(
                cb => cb.checked
            );


        // Als nog niet alles geselecteerd is,
        // toon knop bij eerste geselecteerde rij
        if (!allSelected) {

            const firstSelected =
                selected[0];

            const row =
                firstSelected.closest('.list-row');

            if (row) {

                const button =
                    row.querySelector('.select-all-same');

                if (button) {
                    button.style.display = 'inline-block';
                }
            }
        }
    }


    // Checkbox veranderen
    checkboxes.forEach(cb => {

        cb.addEventListener('change', function () {

            const partNumber =
                this.dataset.partnumber;


            if (this.checked) {

                const selected =
                    Array.from(checkboxes)
                        .filter(cb => cb.checked);


                const differentPartNumber =
                    selected.some(
                        cb =>
                            cb.dataset.partnumber !== partNumber
                    );


                if (differentPartNumber) {

                    alert(
                        @Html.Raw(
                            System.Text.Json.JsonSerializer.Serialize(
                                Localizer["ErrorDiffirentInjectorPartNumber"].Value + "."
                            )
                        )
                    );

                    this.checked = false;
                }
            }


            updateSelection();
        });
    });


    // Selecteer alle met hetzelfde onderdeelnummer
    selectAllSameButtons.forEach(button => {

        button.addEventListener('click', function () {

            const partNumber =
                this.dataset.partnumber;


            checkboxes.forEach(cb => {

                if (cb.dataset.partnumber === partNumber) {
                    cb.checked = true;
                }

            });


            updateSelection();
        });
    });


    // Selectie wissen
    clearSelectedButton.addEventListener('click', function () {

        checkboxes.forEach(cb => {
            cb.checked = false;
        });


        updateSelection();
    });


    // Initiële status
    updateSelection();


    // Herstel na browser back/forward cache
    window.addEventListener(
        'pageshow',
        updateSelection
    );
</script>