@using System.Globalization
@using Microsoft.Extensions.Localization
@using TestFusion.Core
@using TestFusion.Core.Interfaces
@inject ITimeZoneService TimeZoneService
@inject IStringLocalizer<SharedResource> Localizer

@{
    ViewData["Title"] = Localizer["PageTitleHome"];

    var resultLimit =
        ViewBag.ResultLimit is int limit
            ? limit
            : 50;

    var totalCount =
        ViewBag.TotalCount is int count
            ? count
            : Model.Count;

    var filterPartNumber =
        Context.Request.Query["partNumber"].FirstOrDefault()
        ?? string.Empty;

    var filterBrand =
        Context.Request.Query["brand"].FirstOrDefault()
        ?? string.Empty;

    var filterType =
        Context.Request.Query["type"].FirstOrDefault()
        ?? string.Empty;

    var filterInjectorSerialNumber =
        Context.Request.Query["injectorSerialNumber"].FirstOrDefault()
        ?? string.Empty;

    var filterCustomerName =
        Context.Request.Query["customerName"].FirstOrDefault()
        ?? string.Empty;

    var filterCustomerPhone =
        Context.Request.Query["customerPhone"].FirstOrDefault()
        ?? string.Empty;

    var filterCustomerMail =
        Context.Request.Query["customerMail"].FirstOrDefault()
        ?? string.Empty;

    var filterCustomerNotes =
        Context.Request.Query["customerNotes"].FirstOrDefault()
        ?? string.Empty;

    var filterTestNotes =
        Context.Request.Query["testNotes"].FirstOrDefault()
        ?? string.Empty;

    var filterDateFrom =
        Context.Request.Query["dateFrom"].FirstOrDefault()
        ?? string.Empty;

    var filterDateTo =
        Context.Request.Query["dateTo"].FirstOrDefault()
        ?? string.Empty;

    var hasActiveFilters =
        !string.IsNullOrWhiteSpace(filterPartNumber) ||
        !string.IsNullOrWhiteSpace(filterBrand) ||
        !string.IsNullOrWhiteSpace(filterType) ||
        !string.IsNullOrWhiteSpace(filterInjectorSerialNumber) ||
        !string.IsNullOrWhiteSpace(filterCustomerName) ||
        !string.IsNullOrWhiteSpace(filterCustomerPhone) ||
        !string.IsNullOrWhiteSpace(filterCustomerMail) ||
        !string.IsNullOrWhiteSpace(filterCustomerNotes) ||
        !string.IsNullOrWhiteSpace(filterTestNotes) ||
        !string.IsNullOrWhiteSpace(filterDateFrom) ||
        !string.IsNullOrWhiteSpace(filterDateTo);

    var clearFiltersUrl = Url.Action("Index", "Home");
    var differentPartNumberMessage =
        $"{Localizer["ErrorDiffirentInjectorPartNumber"].Value}{Localizer["SymbolDot"].Value}";

    const int samePartNumberGroupGapMinutes = 60 * 24 * 7;

    var timeGroupById =
        new Dictionary<string, int>();

    foreach (var partNumberGroup in Model.GroupBy(x => x.PartNumber))
    {
        var orderedItems =
            partNumberGroup
                .OrderBy(x => x.TimeOffTesting)
                .ToList();

        var groupNumber = 0;

        for (var i = 0; i < orderedItems.Count; i++)
        {
            if (i > 0)
            {
                var previous =
                    orderedItems[i - 1];

                var current =
                    orderedItems[i];

                var gap =
                    current.TimeOffTesting -
                    previous.TimeOffTesting;

                if (gap >
                    TimeSpan.FromMinutes(
                        samePartNumberGroupGapMinutes))
                {
                    groupNumber++;
                }
            }

            timeGroupById[
                orderedItems[i].Id
            ] = groupNumber;
        }
    }

}

@functions {
    private string FormatTimeWindow(int minutes)
    {
        const int minutesPerHour = 60;
        const int minutesPerDay = 60 * 24;
        const int minutesPerWeek = 60 * 24 * 7;
        const int minutesPerMonth = 60 * 24 * 30;
        const int minutesPerYear = 60 * 24 * 365;

        if (minutes >= minutesPerYear &&
            minutes % minutesPerYear == 0)
        {
            var value = minutes / minutesPerYear;

            return FormatTimeValue(
                value,
                "TimeYear",
                "TimeYears"
            );
        }

        if (minutes >= minutesPerMonth &&
            minutes % minutesPerMonth == 0)
        {
            var value = minutes / minutesPerMonth;

            return FormatTimeValue(
                value,
                "TimeMonth",
                "TimeMonths"
            );
        }

        if (minutes >= minutesPerWeek &&
            minutes % minutesPerWeek == 0)
        {
            var value = minutes / minutesPerWeek;

            return FormatTimeValue(
                value,
                "TimeWeek",
                "TimeWeeks"
            );
        }

        if (minutes >= minutesPerDay &&
            minutes % minutesPerDay == 0)
        {
            var value = minutes / minutesPerDay;

            return FormatTimeValue(
                value,
                "TimeDay",
                "TimeDays"
            );
        }

        if (minutes >= minutesPerHour &&
            minutes % minutesPerHour == 0)
        {
            var value = minutes / minutesPerHour;

            return FormatTimeValue(
                value,
                "TimeHour",
                "TimeHours"
            );
        }

        return FormatTimeValue(
            minutes,
            "TimeMinute",
            "TimeMinutes"
        );
    }


    private string FormatTimeValue(
        int value,
        string singularResourceKey,
        string pluralResourceKey)
    {
        var unit =
            value == 1
                ? Localizer[singularResourceKey].Value
                : Localizer[pluralResourceKey].Value;

        return $"{value} {unit}";
    }
}

@model List<TestFusion.Core.Models.TestReportModel>

<link rel="stylesheet"
      href="~/css/home.css"
      asp-append-version="true" />


<form id="refresh-form"
      asp-controller="Home"
      asp-action="Refresh"
      method="post">
</form>


<form id="result-limit-form"
      asp-controller="Home"
      asp-action="Index"
      method="get">
</form>


<form id="filter-form"
      asp-controller="Home"
      asp-action="Index"
      method="get">
</form>

<div id="home-js-config"
     hidden
     data-has-applied-filters="@hasActiveFilters.ToString().ToLowerInvariant()"
     data-clear-filters-url="@clearFiltersUrl"
     data-different-part-number-message="@differentPartNumberMessage">
</div>



<form asp-controller="Analysis"
      asp-action="Generate"
      method="post">

    <div id="top-bar">

        <div class="top-bar-left">

            <h2>
                @Localizer["TestResultsOverview"]
            </h2>


            <button type="submit"
                    form="refresh-form"
                    class="btn">
                @Localizer["ButtonRefresh"]
            </button>


            @if (!hasActiveFilters)
            {
                <div class="result-limit-container">

                    <label for="resultLimit">
                        @Localizer["Show"]:
                    </label>

                    <select id="resultLimit"
                            name="resultLimit"
                            form="result-limit-form"
                            class="result-limit-select"
                            onchange="this.form.submit()">

                        @if (resultLimit == 25)
                        {
                            <option value="25" selected>
                                25
                            </option>
                        }
                        else
                        {
                            <option value="25">
                                25
                            </option>
                        }

                        @if (resultLimit == 50)
                        {
                            <option value="50" selected>
                                50
                            </option>
                        }
                        else
                        {
                            <option value="50">
                                50
                            </option>
                        }

                        @if (resultLimit == 100)
                        {
                            <option value="100" selected>
                                100
                            </option>
                        }
                        else
                        {
                            <option value="100">
                                100
                            </option>
                        }

                        @if (resultLimit == 0)
                        {
                            <option value="0" selected>
                                @Localizer["All"] (@totalCount)
                            </option>
                        }
                        else
                        {
                            <option value="0">
                                @Localizer["All"] (@totalCount)
                            </option>
                        }

                    </select>

                </div>
            }

            <button type="button"
                    id="filter-toggle"
                    class="btn"
                    aria-expanded="@hasActiveFilters.ToString().ToLowerInvariant()"
                    aria-controls="filter-panel"
                    data-symbol-expanded="@Localizer["SymbolTriangleUp"]"
                    data-symbol-collapsed="@Localizer["SymbolTriangleDown"]">
                @Localizer["ButtonFilter"]
                <span id="filter-toggle-indicator">
                    @(hasActiveFilters ? Localizer["SymbolTriangleUp"].Value : Localizer["SymbolTriangleDown"].Value)
                </span>
            </button>

        </div>


        <div class="top-bar-right">

            <button type="button"
                    id="clear-selected"
                    class="btn"
                    disabled>
                @Localizer["ButtonClearSelected"]
            </button>


            <button type="submit"
                    id="generate-analysis"
                    class="btn"
                    disabled>
                @Localizer["ButtonGenerateAnalysis"]
            </button>

        </div>

    </div>


    <div id="filter-panel"
         class="filter-panel @(hasActiveFilters ? "is-open" : "")">

        <div class="filter-groups">

            <section class="filter-group">

                <h3 class="filter-group-title">
                    @Localizer["FilterSectionPart"]
                </h3>

                <div class="filter-group-fields filter-group-fields-3">

                    <div class="filter-field">

                        <label for="filter-partnumber">
                            @Localizer["InjectorPartNumber"]
                        </label>

                        <input type="text"
                               id="filter-partnumber"
                               name="partNumber"
                               form="filter-form"
                               class="filter-input"
                               value="@filterPartNumber"
                               autocomplete="off" />

                    </div>


                    <div class="filter-field">

                        <label for="filter-brand">
                            @Localizer["InjectorBrand"]
                        </label>

                        <input type="text"
                               id="filter-brand"
                               name="brand"
                               form="filter-form"
                               class="filter-input"
                               value="@filterBrand"
                               autocomplete="off" />

                    </div>


                    <div class="filter-field">

                        <label for="filter-type">
                            @Localizer["InjectorType"]
                        </label>

                        <input type="text"
                               id="filter-type"
                               name="type"
                               form="filter-form"
                               class="filter-input"
                               value="@filterType"
                               autocomplete="off" />

                    </div>

                </div>

            </section>


            <section class="filter-group">

                <h3 class="filter-group-title">
                    @Localizer["FilterSectionCustomer"]
                </h3>

                <div class="filter-group-fields filter-group-fields-4">

                    <div class="filter-field">

                        <label for="filter-customer-name">
                            @Localizer["CustomerName"]
                        </label>

                        <input type="text"
                               id="filter-customer-name"
                               name="customerName"
                               form="filter-form"
                               class="filter-input"
                               value="@filterCustomerName"
                               autocomplete="off" />

                    </div>


                    <div class="filter-field">

                        <label for="filter-customer-phone">
                            @Localizer["CustomerPhoneNumber"]
                        </label>

                        <input type="text"
                               id="filter-customer-phone"
                               name="customerPhone"
                               form="filter-form"
                               class="filter-input"
                               value="@filterCustomerPhone"
                               autocomplete="off" />

                    </div>


                    <div class="filter-field">

                        <label for="filter-customer-mail">
                            @Localizer["CustomerMail"]
                        </label>

                        <input type="text"
                               id="filter-customer-mail"
                               name="customerMail"
                               form="filter-form"
                               class="filter-input"
                               value="@filterCustomerMail"
                               autocomplete="off" />

                    </div>


                    <div class="filter-field">

                        <label for="filter-customer-notes">
                            @Localizer["CustomerNote"]
                        </label>

                        <input type="text"
                               id="filter-customer-notes"
                               name="customerNotes"
                               form="filter-form"
                               class="filter-input"
                               value="@filterCustomerNotes"
                               autocomplete="off" />

                    </div>

                </div>

            </section>


            <section class="filter-group">

                <h3 class="filter-group-title">
                    @Localizer["FilterSectionTest"]
                </h3>

                <div class="filter-group-fields filter-group-fields-2">

                    <div class="filter-field">

                        <label for="filter-injector-serial-number">
                            @Localizer["InjectorSerialNumber"]
                        </label>

                        <input type="text"
                               id="filter-injector-serial-number"
                               name="injectorSerialNumber"
                               form="filter-form"
                               class="filter-input"
                               value="@filterInjectorSerialNumber"
                               autocomplete="off" />

                    </div>


                    <div class="filter-field">

                        <label for="filter-test-notes">
                            @Localizer["TestNotes"]
                        </label>

                        <input type="text"
                               id="filter-test-notes"
                               name="testNotes"
                               form="filter-form"
                               class="filter-input"
                               value="@filterTestNotes"
                               autocomplete="off" />

                    </div>

                </div>

            </section>


            <section class="filter-group">

                <h3 class="filter-group-title">
                    @Localizer["FilterSectionDate"]
                </h3>

                <div class="filter-group-fields filter-group-fields-2">

                    <div class="filter-field">

                        <label for="filter-date-from">
                            @Localizer["FilterDateFrom"]
                        </label>

                        <input type="date"
                               id="filter-date-from"
                               name="dateFrom"
                               form="filter-form"
                               class="filter-input"
                               value="@filterDateFrom" />

                    </div>


                    <div class="filter-field">

                        <label for="filter-date-to">
                            @Localizer["FilterDateTo"]
                        </label>

                        <input type="date"
                               id="filter-date-to"
                               name="dateTo"
                               form="filter-form"
                               class="filter-input"
                               value="@filterDateTo" />

                    </div>

                </div>

            </section>

        </div>


        <div class="filter-actions">

            <button type="submit"
                    id="apply-filters"
                    form="filter-form"
                    class="btn"
                    disabled>
                @Localizer["ButtonApplyFilters"]
            </button>

            <button type="button"
                    id="clear-filters"
                    class="btn"
                    disabled>
                @Localizer["ButtonClearFilters"]
            </button>

        </div>

    </div>


    <div class="list"
         id="test-results-list"
         data-symbol-sort-neutral="@Localizer["SymbolArrowUpDown"]"
         data-symbol-sort-ascending="@Localizer["SymbolTriangleUp"]"
         data-symbol-sort-descending="@Localizer["SymbolTriangleDown"]">

        <div class="list-row header">

            <span class="sort-reset-cell">

                <button type="button"
                        id="reset-sort"
                        class="btn sort-reset-button"
                        disabled>
                    @Localizer["ButtonResetSorting"]
                </button>

            </span>


            <span>

                <button type="button"
                        class="sort-button"
                        data-sort="partnumber">

                    @Localizer["InjectorPartNumber"]

                    <span class="sort-indicator">
                        @Localizer["SymbolArrowUpDown"]
                    </span>

                </button>

            </span>


            <span>

                <button type="button"
                        class="sort-button"
                        data-sort="brand">

                    @Localizer["InjectorBrand"]

                    <span class="sort-indicator">
                        @Localizer["SymbolArrowUpDown"]
                    </span>

                </button>

            </span>


            <span>

                <button type="button"
                        class="sort-button"
                        data-sort="type">

                    @Localizer["InjectorType"]

                    <span class="sort-indicator">
                        @Localizer["SymbolArrowUpDown"]
                    </span>

                </button>

            </span>


            <span>

                <button type="button"
                        class="sort-button"
                        data-sort="datetime">

                    @Localizer["InjectorDateTime"]

                    <span class="sort-indicator">
                        @Localizer["SymbolArrowUpDown"]
                    </span>

                </button>

            </span>

        </div>


        @foreach (var item in Model)
        {
            <div class="list-row data-row"
                 data-partnumber="@item.PartNumber"
                 data-brand="@item.PartBrand"
                 data-type="@item.PartType"
                 data-datetime="@item.TimeOffTesting.UtcTicks"
                 data-timegroup="@timeGroupById[item.Id]">

                <span class="selection-cell">

                    <input type="checkbox"
                           name="selectedIds"
                           value="@item.Id"
                           data-partnumber="@item.PartNumber"
                           data-timegroup="@timeGroupById[item.Id]">


                    <span class="selection-buttons">

                        <button type="button"
                                class="select-all-same btn"
                                data-partnumber="@item.PartNumber"
                                style="display: none;">

                            <span class="select-all-title">
                                @Localizer["ButtonSelectAllSamePartNumber"]
                            </span>

                            <span class="select-all-total">

                                @Localizer["Total"]:

                                <span class="select-all-count">
                                    0
                                </span>

                            </span>

                        </button>


                        <button type="button"
                                class="select-time-group btn"
                                data-partnumber="@item.PartNumber"
                                data-timegroup="@timeGroupById[item.Id]"
                                style="display: none;">

                            <span class="select-all-title">
                                @($"{Localizer["ButtonSelectSamePartNumberWithTimeRestraint"].Value} {FormatTimeWindow(samePartNumberGroupGapMinutes)}")
                            </span>

                            <span class="select-all-total">

                                @Localizer["Total"]:

                                <span class="select-time-group-count">
                                    0
                                </span>

                            </span>

                        </button>

                    </span>

                </span>


                <span>
                    @item.PartNumber
                </span>

                <span>
                    @item.PartBrand
                </span>

                <span>
                    @item.PartType
                </span>

                <span>
                    @TimeZoneService.FormatForUser(item.TimeOffTesting, "dd-MM-yyyy HH:mm")
                </span>

            </div>
        }

    </div>

</form>



@section Scripts {
    <script src="~/js/home.js" asp-append-version="true"></script>
}
