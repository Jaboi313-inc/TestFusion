@using System.Globalization
@using Microsoft.Extensions.Localization
@using TestFusion.Core
@inject IStringLocalizer<SharedResource> Localizer

@{
    ViewData["Title"] = Localizer["PageTitelHome"];
}

@model List<TestFusion.Core.Models.TestListItemModel>

<link rel="stylesheet" href="~/css/home.css" />

<form id="refresh-form"
      asp-controller="Home"
      asp-action="Refresh"
      method="post">
</form>

<form asp-controller="Analysis"
      asp-action="Generate"
      method="post">

    <div id="top-bar">

        <div class="top-bar-left">
            <h2>@Localizer["TestResultsOverview"]</h2>

            <button type="submit"
                    form="refresh-form"
                    class="btn">
                @Localizer["ButtonRefresh"]
            </button>
        </div>

        <div class="top-bar-right">

            <button type="button"
                    id="clear-selected"
                    class="btn"
                    disabled>
                @Localizer["ButtonClearSelected"]
            </button>

            <button type="submit"
                    id="generate-analysis"
                    class="btn"
                    disabled>
                @Localizer["ButtonGenerateAnalysis"]
            </button>

        </div>

    </div>

    <div class="list" id="test-results-list">

        <div class="list-row header">

            <span class="sort-reset-cell">
                <button type="button"
                        id="reset-sort"
                        class="btn sort-reset-button"
                        disabled>
                    @Localizer["ButtonResetSorting"]
                </button>
            </span>

            <span>
                <button type="button"
                        class="sort-button"
                        data-sort="partnumber">
                    @Localizer["InjectorPartNumber"]
                    <span class="sort-indicator">↕</span>
                </button>
            </span>

            <span>
                <button type="button"
                        class="sort-button"
                        data-sort="brand">
                    @Localizer["InjectorBrand"]
                    <span class="sort-indicator">↕</span>
                </button>
            </span>

            <span>
                <button type="button"
                        class="sort-button"
                        data-sort="type">
                    @Localizer["InjectorType"]
                    <span class="sort-indicator">↕</span>
                </button>
            </span>

            <span>
                <button type="button"
                        class="sort-button"
                        data-sort="datetime">
                    @Localizer["InjectorDateTime"]
                    <span class="sort-indicator">↕</span>
                </button>
            </span>

        </div>

        @foreach (var item in Model)
        {
            <div class="list-row data-row"
                 data-partnumber="@item.PartNumber"
                 data-brand="@item.PartBrand"
                 data-type="@item.PartType"
                 data-datetime="@item.DateTime.ToUniversalTime().Ticks">

                <span class="selection-cell">

                    <input type="checkbox"
                           name="selectedIds"
                           value="@item.Id"
                           data-partnumber="@item.PartNumber">

                    <button type="button"
                            class="select-all-same btn"
                            data-partnumber="@item.PartNumber"
                            style="display: none;">

                        <span class="select-all-title">
                            @Localizer["ButtonSelectAllSamePartNumber"]
                        </span>

                        <span class="select-all-total">
                            @Localizer["Total"]:
                            <span class="select-all-count">0</span>
                        </span>

                    </button>

                </span>

                <span>@item.PartNumber</span>
                <span>@item.PartBrand</span>
                <span>@item.PartType</span>
                <span>@item.DateTime.ToString("dd-MM-yyyy HH:mm")</span>

            </div>
        }

    </div>

</form>

<script>
    let selectedPartNumber = null;

    let currentSortColumn = null;
    let currentSortDirection = 'asc';


    const checkboxes = document.querySelectorAll(
        'input[type="checkbox"][name="selectedIds"]'
    );

    const selectAllSameButtons =
        document.querySelectorAll('.select-all-same');

    const clearSelectedButton =
        document.getElementById('clear-selected');

    const generateAnalysisButton =
        document.getElementById('generate-analysis');

    const sortButtons =
        document.querySelectorAll('.sort-button');

    const resetSortButton =
        document.getElementById('reset-sort');

    const testResultsList =
        document.getElementById('test-results-list');


    // Bewaar de originele volgorde zoals deze vanaf de server kwam
    const originalRows =
        Array.from(
            testResultsList.querySelectorAll('.data-row')
        );


    function getCheckboxesInCurrentOrder() {

        return Array.from(
            document.querySelectorAll(
                'input[type="checkbox"][name="selectedIds"]'
            )
        );
    }


    function updateSelection() {

        const currentCheckboxes =
            getCheckboxesInCurrentOrder();

        const selected =
            currentCheckboxes.filter(cb => cb.checked);


        // Verberg eerst alle select-all knoppen
        selectAllSameButtons.forEach(button => {
            button.style.display = 'none';
        });


        // Niets geselecteerd
        if (selected.length === 0) {

            selectedPartNumber = null;

            generateAnalysisButton.disabled = true;
            clearSelectedButton.disabled = true;

            return;
        }


        clearSelectedButton.disabled = false;


        const partNumbers = [
            ...new Set(
                selected.map(
                    cb => cb.dataset.partnumber
                )
            )
        ];


        // Voor de zekerheid: meerdere verschillende partnummers
        if (partNumbers.length !== 1) {

            generateAnalysisButton.disabled = true;

            return;
        }


        selectedPartNumber =
            partNumbers[0];

        generateAnalysisButton.disabled = false;


        const samePartNumberCheckboxes =
            currentCheckboxes.filter(
                cb =>
                    cb.dataset.partnumber ===
                    selectedPartNumber
            );


        const allSelected =
            samePartNumberCheckboxes.every(
                cb => cb.checked
            );


        // Toon select-all bij de eerste geselecteerde rij
        if (!allSelected) {

            const firstSelected =
                selected[0];

            const row =
                firstSelected.closest('.list-row');


            if (row) {

                const button =
                    row.querySelector('.select-all-same');


                if (button) {

                    const count =
                        samePartNumberCheckboxes.length;

                    const countElement =
                        button.querySelector(
                            '.select-all-count'
                        );


                    if (countElement) {
                        countElement.textContent = count;
                    }


                    button.style.display =
                        'inline-flex';
                }
            }
        }
    }


    function comparePartNumbers(valueA, valueB) {

        valueA =
            (valueA ?? '')
                .trim()
                .toUpperCase();

        valueB =
            (valueB ?? '')
                .trim()
                .toUpperCase();


        function getCharacterGroup(character) {

            // Cijfers eerst
            if (/[0-9]/.test(character)) {
                return 0;
            }

            // Daarna letters
            if (/[A-Z]/.test(character)) {
                return 1;
            }

            // Daarna overige tekens zoals . - /
            return 2;
        }


        const maxLength =
            Math.max(
                valueA.length,
                valueB.length
            );


        for (let i = 0; i < maxLength; i++) {

            const charA =
                valueA[i];

            const charB =
                valueB[i];


            // Als beide tot hier gelijk zijn:
            // kortste waarde eerst
            if (charA === undefined) {
                return -1;
            }

            if (charB === undefined) {
                return 1;
            }


            if (charA === charB) {
                continue;
            }


            const groupA =
                getCharacterGroup(charA);

            const groupB =
                getCharacterGroup(charB);


            // Cijfer < letter < overige tekens
            if (groupA !== groupB) {
                return groupA - groupB;
            }


            // Binnen dezelfde groep normaal vergelijken
            if (charA < charB) {
                return -1;
            }

            if (charA > charB) {
                return 1;
            }
        }


        return 0;
    }


    function sortRows(column) {

        // Zelfde kolom opnieuw aangeklikt:
        // wissel tussen oplopend en aflopend
        if (currentSortColumn === column) {

            currentSortDirection =
                currentSortDirection === 'asc'
                    ? 'desc'
                    : 'asc';
        }
        else {

            // Nieuwe kolom begint altijd oplopend
            currentSortColumn = column;
            currentSortDirection = 'asc';
        }


        const rows =
            Array.from(
                testResultsList.querySelectorAll(
                    '.data-row'
                )
            );


        rows.sort((a, b) => {

            let comparison = 0;


            // Datum numeriek sorteren
            if (column === 'datetime') {

                const valueA =
                    Number(a.dataset.datetime);

                const valueB =
                    Number(b.dataset.datetime);

                comparison =
                    valueA - valueB;
            }

            // Part number krijgt eigen sorteerlogica
            else if (column === 'partnumber') {

                comparison =
                    comparePartNumbers(
                        a.dataset.partnumber,
                        b.dataset.partnumber
                    );
            }

            // Brand en type normaal alfabetisch sorteren
            else {

                const valueA =
                    a.dataset[column] ?? '';

                const valueB =
                    b.dataset[column] ?? '';


                comparison =
                    valueA.localeCompare(
                        valueB,
                        undefined,
                        {
                            numeric: true,
                            sensitivity: 'base'
                        }
                    );
            }


            return currentSortDirection === 'asc'
                ? comparison
                : -comparison;
        });


        // Rijen opnieuw in de DOM plaatsen
        rows.forEach(row => {
            testResultsList.appendChild(row);
        });


        // Resetknop activeren
        resetSortButton.disabled = false;


        updateSortIndicators();
        updateSelection();
    }


    function resetSorting() {

        // Originele servervolgorde herstellen
        originalRows.forEach(row => {
            testResultsList.appendChild(row);
        });


        currentSortColumn = null;
        currentSortDirection = 'asc';


        // Resetknop weer uitschakelen
        resetSortButton.disabled = true;


        updateSortIndicators();
        updateSelection();
    }


    function updateSortIndicators() {

        sortButtons.forEach(button => {

            const indicator =
                button.querySelector(
                    '.sort-indicator'
                );


            if (!indicator) {
                return;
            }


            // Niet actieve kolommen
            if (
                button.dataset.sort !==
                currentSortColumn
            ) {

                indicator.textContent = '↕';

                return;
            }


            // Actieve kolom
            indicator.textContent =
                currentSortDirection === 'asc'
                    ? '▲'
                    : '▼';
        });
    }


    // Checkbox selectie
    checkboxes.forEach(cb => {

        cb.addEventListener(
            'change',
            function () {

                const partNumber =
                    this.dataset.partnumber;


                if (this.checked) {

                    const selected =
                        getCheckboxesInCurrentOrder()
                            .filter(cb => cb.checked);


                    const differentPartNumber =
                        selected.some(
                            cb =>
                                cb.dataset.partnumber !==
                                partNumber
                        );


                    if (differentPartNumber) {

                        alert(
                            @Html.Raw(
                                System.Text.Json.JsonSerializer.Serialize(
                                    Localizer["ErrorDiffirentInjectorPartNumber"].Value + "."
                                )
                            )
                        );

                        this.checked = false;
                    }
                }


                updateSelection();
            }
        );
    });


    // Selecteer alle met hetzelfde onderdeelnummer
    selectAllSameButtons.forEach(button => {

        button.addEventListener(
            'click',
            function () {

                const partNumber =
                    this.dataset.partnumber;


                getCheckboxesInCurrentOrder()
                    .forEach(cb => {

                        if (
                            cb.dataset.partnumber ===
                            partNumber
                        ) {

                            cb.checked = true;
                        }

                    });


                updateSelection();
            }
        );
    });


    // Sorteerknoppen
    sortButtons.forEach(button => {

        button.addEventListener(
            'click',
            function () {

                sortRows(
                    this.dataset.sort
                );
            }
        );
    });


    // Sortering resetten
    resetSortButton.addEventListener(
        'click',
        resetSorting
    );


    // Geselecteerde resultaten wissen
    clearSelectedButton.addEventListener(
        'click',
        function () {

            getCheckboxesInCurrentOrder()
                .forEach(cb => {

                    cb.checked = false;
                });


            updateSelection();
        }
    );


    // Beginstatus
    updateSelection();
    updateSortIndicators();

    resetSortButton.disabled = true;


    // Herstel selectie bij browser back/forward
    window.addEventListener(
        'pageshow',
        function () {

            updateSelection();
            updateSortIndicators();

            resetSortButton.disabled =
                currentSortColumn === null;
        }
    );
</script>