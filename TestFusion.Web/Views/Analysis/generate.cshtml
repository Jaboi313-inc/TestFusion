@model TestFusion.Core.Models.WebModels.GeneratedModel

@{
    ViewData["Title"] = "Gegenereerde analyse";
}

@functions {
    public string NormalizeTestName(string name)
        => name.Replace(" : SKIPPED", "").Trim();
}

<link rel="stylesheet" href="~/css/site.css" />
<link rel="stylesheet" href="~/css/analysis.css" />


<div class="d-flex justify-content-between align-items-center mb-4">

    <h2 class="mb-0">
        Vergelijking verstuivers
    </h2>

    <form asp-controller="Analysis"
          asp-action="GeneratePdf"
          method="post">

        @foreach (var id in Model.SelectedIds)
        {
            <input type="hidden"
                   name="selectedIds"
                   value="@id" />
        }

        <button type="submit"
                class="btn btn-primary">
            PDF downloaden
        </button>

    </form>

</div>


<table class="table table-bordered table-striped">

    <thead>
        <tr class="info-row">
            <th class="info-column">
                <strong>Verstuiver:</strong>

                <div>
                    Nummer:
                    @Model.Injectors.FirstOrDefault()?.Data.PartNumber
                </div>

                <div>
                    Merk:
                    @Model.Injectors.FirstOrDefault()?.Data.PartBrand
                </div>

                <div>
                    Type:
                    @Model.Injectors.FirstOrDefault()?.Data.PartType
                </div>

                <br />

            </th>
            <th class="info-column">
                <strong>Klant:</strong>

                <div>
                    Naam:
                    @Model.Injectors.FirstOrDefault()?.Data.CustomerName
                </div>


                @if (!string.IsNullOrWhiteSpace(
                    Model.Injectors.FirstOrDefault()?.Data.CustomerPhone))
                {
                    <div>
                        Tel:
                        @Model.Injectors.FirstOrDefault()?.Data.CustomerPhone
                    </div>
                }


                @if (!string.IsNullOrWhiteSpace(
                    Model.Injectors.FirstOrDefault()?.Data.CustomerMail))
                {
                    <div>
                        Mail:
                        @Model.Injectors.FirstOrDefault()?.Data.CustomerMail
                    </div>
                }


                @if (!string.IsNullOrWhiteSpace(
                    Model.Injectors.FirstOrDefault()?.Data.CustomerNotes))
                {
                    <div>
                        Notitie:
                        @Model.Injectors.FirstOrDefault()?.Data.CustomerNotes
                    </div>
                }
            </th>
        </tr>
        <tr>
            <th>
                <br />

                <div>
                    Datum en tijd van testen:
                </div>
            </th>


            @foreach (var injector in Model.Injectors)
            {
                <th>

                    <br />

                    <div>
                        @(injector.Data.TimeOffTesting.ToString("dd-MM-yyyy HH:mm"))
                    </div>

                    <br />


                    @if (!string.IsNullOrWhiteSpace(
                        injector.Data.TestNotes))
                    {
                        <strong>Notitie:</strong>

                        <br />

                        <small>
                            @Html.Raw(injector.Data.TestNotes)
                        </small>
                    }
                </th>
            }
        </tr>
        <tr>
            <th>

                <br />

                Test / Tank

                <br />

            </th>
        </tr>
    </thead>

    <tbody>

        @foreach (var test in Model.AllTests)
        {
            var normalizedTest =
                NormalizeTestName(test.TestName);

            var tankSubData = Model.Injectors
                .First()
                .Data.Tests
                .Where(t =>
                    NormalizeTestName(t.TestName)
                    == normalizedTest)
                .SelectMany(t => t.SubTests)
                .ToList();

            <!-- header -->
            <tr class="test-header">
                <td colspan="@(Model.Injectors.Count + 1)">
                    <div>

                        <strong>
                            @normalizedTest
                        </strong>

                        <br />

                        <small>
                            Response time:
                            @test.TestResponseTime s
                        </small>

                        <br />

                        <small>
                            Test type:
                            @test.TestType
                        </small>

                    </div>

                </td>
            </tr>

            foreach (var tank in tankSubData)
            {
                <tr class="tank-row">

                    <!-- left side -->
                    <td>
                        @{
                            var average =
                                (tank.Min + tank.Max) / 2;

                            var tolerance =
                                average - tank.Min;
                        }


                        @tank.TankName

                        <br />

                        <small>
                            Min: @tank.Min
                        </small>

                        <br />

                        <small>
                            Max: @tank.Max
                        </small>

                        <br />

                        <small>
                            Limiet:
                            @average +/- @tolerance
                        </small>

                    </td>

                    <!-- injector columns -->
                    @foreach (var injector in Model.Injectors)
                    {
                        var sub = injector.Data.Tests
                            .Where(t =>
                                NormalizeTestName(t.TestName)
                                == normalizedTest)
                            .SelectMany(t => t.SubTests)
                            .FirstOrDefault(s =>
                                s.TankName == tank.TankName);


                        <td class="result-@(sub?.ResultColor ?? 0)">
                            @if (sub == null)
                            {
                                <strong>
                                    Skipped
                                </strong>
                            }
                            else if (sub.Results == null ||
                                     sub.Results.Count == 0)
                            {
                                <strong>
                                    Geen resultaten
                                </strong>
                            }
                            else
                            {
                                var results = sub.Results;

                                var resultMinCalculated =
                                    results.Min();

                                var resultAverageCalculated =
                                    results.Average();

                                var resultMaxCalculated =
                                    results.Max();


                                <div>

                                    <strong>
                                        Min:
                                    </strong>

                                    @resultMinCalculated
                                    @sub.ResultMin

                                </div>

                                <div>

                                    <strong>
                                        Avg:
                                    </strong>

                                    @resultAverageCalculated.ToString("0.0")
                                    @sub.ResultAverage

                                </div>

                                <div>

                                    <strong>
                                        Max:
                                    </strong>

                                    @resultMaxCalculated
                                    @sub.ResultMax

                                </div>


                                <br />


                                <div>

                                    <strong>
                                        Results:
                                    </strong>

                                    @string.Join(
                                        " | ",
                                        sub.Results)

                                </div>
                            }
                        </td>
                    }

                </tr>
            }
        }

    </tbody>

</table>