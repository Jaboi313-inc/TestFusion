@model TestFusion.Core.Models.WebModels.GeneratedModel

@{
    ViewData["Title"] = "Gegenereerde analyse";
}

@functions {
    public string NormalizeTestName(string name)
        => name.Replace(" : SKIPPED", "").Trim();
}

<link rel="stylesheet" href="~/css/site.css" />
<link rel="stylesheet" href="~/css/analysis.css" />

<h2 class="mb-4">Vergelijking verstuivers</h2>

<table class="table table-bordered table-striped">

    <thead>
        <tr>
            <th>Test / Tank</th>

            @foreach (var injector in Model.Injectors)
            {
                <th>
                    <div><strong>@injector.Data.PartNumber</strong></div>
                    <div>@injector.Data.PartBrand</div>
                    <div>@injector.Data.PartType</div>
                    <div>@injector.Data.TimeOffTesting.ToString("dd-MM-yyyy HH:mm")</div>
                </th>
            }
        </tr>
    </thead>

    <tbody>

        @foreach (var test in Model.AllTests)
        {
            var normalizedTest = NormalizeTestName(test.TestName);

            var tankSubData = Model.Injectors
                .First()
                .Data.Tests
                .Where(t => NormalizeTestName(t.TestName) == normalizedTest)
                .SelectMany(t => t.SubTests)
                .ToList();

            <!-- header -->
            <tr class="test-header">
                <td colspan="@(Model.Injectors.Count + 1)">
                    <div>
                        <strong>@normalizedTest</strong>
                    </div>
                    
                    
                </td>
            </tr>

            foreach (var tank in tankSubData)
            {
                <tr class="tank-row">

                    <!-- left side -->
                    <td class="tank-column">
                        @{
                            var average = (tank.Min + tank.Max) / 2;
                            var tolerance = average - tank.Min;
                        }

                        @tank.TankName<br />
                        <small>Min: @tank.Min</small><br />
                        <small>Max: @tank.Max</small><br />
                        <small>Limiet: @average +/- @tolerance</small>
                    </td>

                    <!-- injector columns -->
                    @foreach (var injector in Model.Injectors)
                    {
                        var sub = injector.Data.Tests
                            .Where(t => NormalizeTestName(t.TestName) == normalizedTest)
                            .SelectMany(t => t.SubTests)
                            .FirstOrDefault(s => s.TankName == tank.TankName);

                        <td class="result-@(sub?.ResultColor ?? 0)">
                            @if (sub == null)
                            {
                                <span>-</span>
                            }
                            else
                            {
                                <div>
                                    <strong>Results:</strong>
                                    @string.Join(", ", sub.Results)
                                </div>

                                <div>
                                    <strong>Min:</strong>
                                    @sub.ResultMin
                                </div>

                                <div>
                                    <strong>Avg:</strong>
                                    @sub.ResultAverage
                                </div>

                                <div>
                                    <strong>Max:</strong>
                                    @sub.ResultMax
                                </div>
                            }
                        </td>
                    }

                </tr>
            }
        }

    </tbody>

</table>