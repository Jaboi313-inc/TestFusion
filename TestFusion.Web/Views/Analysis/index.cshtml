
@{
    ViewData["Title"] = "Analyse overzicht";
}

@model List<TestFusion.Core.Models.TestListItemModel>

<link rel="stylesheet" href="~/css/site.css" />
<link rel="stylesheet" href="~/css/analysis.css" />


<div class="main-body">
    <form asp-controller="Analysis" asp-action="Refresh" method="post">
        <button type="submit" class="btn">
            Refresh
        </button>
    </form>
</div>

<form asp-controller="Analysis" asp-action="Generate" method="post">

    <div id="top-bar">
        <h2>Testresultaten overzicht</h2>

        <button type="submit" class="main-body btn">
            Genereer analyse
        </button>
    </div>

    <div class="list main-body">

        <div class="list-row header">
            <span></span>
            <span>Verstuiver #</span>
            <span>Merk</span>
            <span>Type</span>
            <span>Datum, Tijd</span>
        </div>

        @foreach (var item in Model)
        {
            <div class="list-row">
                <input type="checkbox" name="selectedIds" value="@item.Id" data-partnumber="@item.PartNumber">
                <span>@item.PartNumber</span>
                <span>@item.PartBrand</span>
                <span>@item.PartType</span>
                <span>@item.DateTime.ToString("dd-MM-yyyy HH:mm")</span>
            </div>
        }

    </div>

</form>

<script>
    let selectedPartNumber = null;

    const checkboxes = document.querySelectorAll('input[type="checkbox"][name="selectedIds"]');

    checkboxes.forEach(cb => {
        cb.addEventListener('change', function () {

            const partNumber = this.dataset.partnumber;

            if (this.checked) {

                if (!selectedPartNumber) {
                    selectedPartNumber = partNumber;
                    return;
                }

                if (partNumber !== selectedPartNumber) {
                    alert("Je kunt alleen verstuivers met dezelfde onderdeel nummer selecteren.");
                    this.checked = false;
                }

            } else {

                const anyChecked = Array.from(checkboxes).some(x => x.checked);

                if (!anyChecked) {
                    selectedPartNumber = null;
                }
            }
        });
    });
</script>

