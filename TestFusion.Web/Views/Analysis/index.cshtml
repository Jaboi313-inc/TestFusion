@using System.Globalization
@using Microsoft.Extensions.Localization
@using TestFusion.Core
@using TestFusion.Core.Interfaces
@using TestFusion.Core.Models.TestResult
@using TestFusion.Core.Models.WebModels
@inject ITimeZoneService TimeZoneService
@inject IStringLocalizer<SharedResource> Localizer

@model TestFusion.Core.Models.WebModels.GeneratedModel

@{
    ViewData["Title"] = Localizer["PageTitleAnalysis"];

    var selectedLayoutMode =
        Context.Request.Query["layoutMode"].FirstOrDefault()
        ?? "Compact";

    var showDebugInformation = false;
    var groupTestsByBaseName = true;

    var matchCustomerName = true;
    var matchCustomerPhone = true;
    var matchCustomerMail = true;
    var matchCustomerNotes = true;

    var customerGroups = Model.Injectors
        .GroupBy(injector => GetCustomerKey(
            injector.Data.CustomerName,
            injector.Data.CustomerPhone,
            injector.Data.CustomerMail,
            injector.Data.CustomerNotes,
            matchCustomerName,
            matchCustomerPhone,
            matchCustomerMail,
            matchCustomerNotes))
        .Select(group => new
        {
            Injectors = group.ToList()
        })
        .ToList();

    var orderedInjectors = customerGroups
        .SelectMany(group => group.Injectors)
        .ToList();

    var customerSegmentStartIndexes = new HashSet<int>();
    var customerStartIndex = 0;

    foreach (var group in customerGroups)
    {
        customerSegmentStartIndexes.Add(customerStartIndex);
        customerStartIndex += group.Injectors.Count;
    }

    var displayTests = Model.AllTests
        .GroupBy(
            test => NormalizeTestName(test.TestName, groupTestsByBaseName),
            StringComparer.OrdinalIgnoreCase)
        .Select(group => group.First())
        .ToList();

    var comparisonValidation = ValidateComparison(Model.Injectors, Localizer, groupTestsByBaseName);
}

@functions {
    public string NormalizeTestName(string name, bool groupTestsByBaseName)
    {
        var normalizedName = name.Replace(" : SKIPPED", "").Trim();

        if (!groupTestsByBaseName)
            return normalizedName;

        var separatorIndex = normalizedName.IndexOf(':');

        return separatorIndex >= 0
            ? normalizedName[..separatorIndex].Trim()
            : normalizedName;
    }

    public string GetCustomerKey(
        string? name,
        string? phone,
        string? mail,
        string? notes,
        bool matchName,
        bool matchPhone,
        bool matchMail,
        bool matchNotes)
    {
        var values = new List<string>();

        if (matchName)
            values.Add("NAME:" + NormalizeCustomerValue(name));

        if (matchPhone)
            values.Add("PHONE:" + NormalizeCustomerValue(phone));

        if (matchMail)
            values.Add("MAIL:" + NormalizeCustomerValue(mail));

        if (matchNotes)
            values.Add("NOTES:" + NormalizeCustomerValue(notes));

        return string.Join("\u001F", values);
    }

    private string NormalizeCustomerValue(string? value)
    {
        if (value == null)
            return "<NULL>";

        var withoutHtml = System.Text.RegularExpressions.Regex.Replace(value, "<.*?>", " ");
        var decoded = System.Net.WebUtility.HtmlDecode(withoutHtml);

        var normalized = System.Text.RegularExpressions.Regex
            .Replace(decoded, @"\s+", " ")
            .Trim();

        if (normalized.Length == 0)
            return "<EMPTY>";

        return normalized.ToUpperInvariant();
    }

    public sealed class ComparisonValidationDetail
    {
        public string Message { get; init; } = "";
        public string TargetId { get; init; } = "";
    }

    public sealed class ComparisonValidationResult
    {
        public List<string> Errors { get; } = new();
        public List<ComparisonValidationDetail> Details { get; } = new();
        public bool IsValid => Errors.Count == 0;
    }

    private sealed class ComparisonTestEntry
    {
        public TestResultViewModel Injector { get; init; } = null!;
        public TestModel Test { get; init; } = null!;
    }

    public ComparisonValidationResult ValidateComparison(
        List<TestResultViewModel> injectors,
        IStringLocalizer<SharedResource> localizer,
        bool groupTestsByBaseName)
    {
        var result = new ComparisonValidationResult();

        if (injectors.Count <= 1)
            return result;

        var referenceInjector = injectors[0];

        var partNumberMismatches = injectors
            .Skip(1)
            .Where(injector => !ComparisonValueEquals(
                injector.Data.PartNumber,
                referenceInjector.Data.PartNumber))
            .ToList();

        if (partNumberMismatches.Count > 0)
        {
            result.Errors.Add(localizer["AnalysisValidationPartNumberMismatch"]);

            foreach (var injector in partNumberMismatches)
            {
                result.Details.Add(new ComparisonValidationDetail
                {
                    TargetId = GetGeneralValidationTargetId(injector),
                    Message =
                        $"{GetInjectorComparisonName(injector)} — PartNumber: " +
                        $"{DisplayComparisonValue(referenceInjector.Data.PartNumber)} ≠ " +
                        $"{DisplayComparisonValue(injector.Data.PartNumber)}"
                });
            }
        }

        var partBrandMismatches = injectors
            .Skip(1)
            .Where(injector => !ComparisonValueEquals(
                injector.Data.PartBrand,
                referenceInjector.Data.PartBrand))
            .ToList();

        if (partBrandMismatches.Count > 0)
        {
            result.Errors.Add(localizer["AnalysisValidationBrandMismatch"]);

            foreach (var injector in partBrandMismatches)
            {
                result.Details.Add(new ComparisonValidationDetail
                {
                    TargetId = GetGeneralValidationTargetId(injector),
                    Message =
                        $"{GetInjectorComparisonName(injector)} — PartBrand: " +
                        $"{DisplayComparisonValue(referenceInjector.Data.PartBrand)} ≠ " +
                        $"{DisplayComparisonValue(injector.Data.PartBrand)}"
                });
            }
        }

        var partTypeMismatches = injectors
            .Skip(1)
            .Where(injector => !ComparisonValueEquals(
                injector.Data.PartType,
                referenceInjector.Data.PartType))
            .ToList();

        if (partTypeMismatches.Count > 0)
        {
            result.Errors.Add(localizer["AnalysisValidationTypeMismatch"]);

            foreach (var injector in partTypeMismatches)
            {
                result.Details.Add(new ComparisonValidationDetail
                {
                    TargetId = GetGeneralValidationTargetId(injector),
                    Message =
                        $"{GetInjectorComparisonName(injector)} — PartType: " +
                        $"{DisplayComparisonValue(referenceInjector.Data.PartType)} ≠ " +
                        $"{DisplayComparisonValue(injector.Data.PartType)}"
                });
            }
        }

        var allTestIds = injectors
            .SelectMany(injector => injector.Data.Tests)
            .Select(test => test.TestId)
            .Distinct()
            .OrderBy(testId => testId)
            .ToList();

        foreach (var testId in allTestIds)
        {
            var availableTests = injectors
                .Select(injector => new
                {
                    Injector = injector,
                    Test = injector.Data.Tests.FirstOrDefault(test => test.TestId == testId)
                })
                .ToList();

            var firstAvailableTest = availableTests
                .FirstOrDefault(entry => entry.Test != null)?
                .Test;

            if (firstAvailableTest == null)
                continue;

            var displayName = NormalizeTestName(firstAvailableTest.TestName, groupTestsByBaseName);

            var missingInjectors = availableTests
                .Where(entry => entry.Test == null)
                .Select(entry => entry.Injector)
                .ToList();

            if (missingInjectors.Count > 0)
            {
                result.Errors.Add(localizer["AnalysisValidationTestMissing", displayName]);

                foreach (var injector in missingInjectors)
                {
                    result.Details.Add(new ComparisonValidationDetail
                    {
                        TargetId = GetValidationTargetId(testId, injector),
                        Message = $"{GetInjectorComparisonName(injector)} — {displayName} — test ontbreekt"
                    });
                }

                continue;
            }

            var testsWithDefinition = availableTests
                .Where(entry => entry.Test != null && entry.Test.TestStatus != 1)
                .Select(entry => new ComparisonTestEntry
                {
                    Injector = entry.Injector,
                    Test = entry.Test!
                })
                .ToList();

            if (testsWithDefinition.Count <= 1)
                continue;

            var canonicalTestName = testsWithDefinition
                .Select(entry => NormalizeTestName(entry.Test.TestName, groupTestsByBaseName))
                .GroupBy(name => name, StringComparer.OrdinalIgnoreCase)
                .OrderByDescending(group => group.Count())
                .First()
                .Key;

            var testNameMismatches = testsWithDefinition
                .Where(entry => !ComparisonValueEquals(
                    NormalizeTestName(entry.Test.TestName, groupTestsByBaseName),
                    canonicalTestName))
                .ToList();

            if (testNameMismatches.Count > 0)
            {
                result.Errors.Add(localizer["AnalysisValidationTestNameMismatch", canonicalTestName]);

                foreach (var entry in testNameMismatches)
                {
                    result.Details.Add(new ComparisonValidationDetail
                    {
                        TargetId = GetValidationTargetId(testId, entry.Injector),
                        Message =
                            $"{GetInjectorComparisonName(entry.Injector)} — {canonicalTestName} — TestName: " +
                            $"{DisplayComparisonValue(canonicalTestName)} ≠ " +
                            $"{DisplayComparisonValue(NormalizeTestName(entry.Test.TestName, groupTestsByBaseName))}"
                    });
                }
            }

            var knownTestTypeEntries = testsWithDefinition
                .Where(entry => !string.IsNullOrWhiteSpace(entry.Test.TestType))
                .ToList();

            if (knownTestTypeEntries.Count > 1)
            {
                var canonicalTestType = knownTestTypeEntries
                    .Select(entry => NormalizeComparisonValue(entry.Test.TestType))
                    .GroupBy(type => type, StringComparer.OrdinalIgnoreCase)
                    .OrderByDescending(group => group.Count())
                    .First()
                    .Key;

                var testTypeMismatches = knownTestTypeEntries
                    .Where(entry => !ComparisonValueEquals(
                        entry.Test.TestType,
                        canonicalTestType))
                    .ToList();

                if (testTypeMismatches.Count > 0)
                {
                    result.Errors.Add(localizer["AnalysisValidationTestTypeMismatch", canonicalTestName]);

                    foreach (var entry in testTypeMismatches)
                    {
                        result.Details.Add(new ComparisonValidationDetail
                        {
                            TargetId = GetValidationTargetId(testId, entry.Injector),
                            Message =
                                $"{GetInjectorComparisonName(entry.Injector)} — {canonicalTestName} — TestType: " +
                                $"{DisplayComparisonValue(canonicalTestType)} ≠ " +
                                $"{DisplayComparisonValue(entry.Test.TestType)}"
                        });
                    }
                }
            }

            var definitionGroups = testsWithDefinition
                .GroupBy(entry => GetSubTestDefinitionSignature(entry.Test))
                .OrderByDescending(group => group.Count())
                .ToList();

            if (definitionGroups.Count > 1)
            {
                result.Errors.Add(localizer["AnalysisValidationTestLimitsMismatch", canonicalTestName]);

                var referenceDefinition = definitionGroups[0].First();

                foreach (var entry in definitionGroups
                    .Skip(1)
                    .SelectMany(group => group))
                {
                    var differences = GetSubTestDefinitionDifferences(
                        referenceDefinition.Test,
                        entry.Test);

                    foreach (var difference in differences)
                    {
                        result.Details.Add(new ComparisonValidationDetail
                        {
                            TargetId = GetValidationTargetId(testId, entry.Injector),
                            Message =
                                $"{GetInjectorComparisonName(entry.Injector)} — " +
                                $"{canonicalTestName} — {difference}"
                        });
                    }
                }
            }
        }

        result.Details.Sort((left, right) =>
            StringComparer.OrdinalIgnoreCase.Compare(left.Message, right.Message));

        return result;
    }

    private string GetSubTestDefinitionSignature(TestModel test)
    {
        return string.Join("||",
            test.SubTests
                .OrderBy(subTest => subTest.TankPosition)
                .ThenBy(subTest => NormalizeComparisonValue(subTest.TankName))
                .Select(subTest => string.Join("|",
                    subTest.TankPosition,
                    NormalizeComparisonValue(subTest.TankName),
                    subTest.Min.ToString(CultureInfo.InvariantCulture),
                    subTest.Max.ToString(CultureInfo.InvariantCulture),
                    subTest.BlueMin.ToString(CultureInfo.InvariantCulture),
                    subTest.BlueMax.ToString(CultureInfo.InvariantCulture),
                    subTest.YellowMin.ToString(CultureInfo.InvariantCulture),
                    subTest.YellowMax.ToString(CultureInfo.InvariantCulture),
                    subTest.TolBlue.ToString(CultureInfo.InvariantCulture),
                    NormalizeComparisonValue(subTest.ProcentMin),
                    NormalizeComparisonValue(subTest.ProcentMax),
                    NormalizeComparisonValue(subTest.ProcentText))));
    }

    private List<string> GetSubTestDefinitionDifferences(
        TestModel referenceTest,
        TestModel otherTest)
    {
        var differences = new List<string>();

        var positions = referenceTest.SubTests
            .Select(subTest => subTest.TankPosition)
            .Union(otherTest.SubTests.Select(subTest => subTest.TankPosition))
            .Distinct()
            .OrderBy(position => position)
            .ToList();

        foreach (var position in positions)
        {
            var referenceSubTests = referenceTest.SubTests
                .Where(subTest => subTest.TankPosition == position)
                .OrderBy(subTest => NormalizeComparisonValue(subTest.TankName))
                .ToList();

            var otherSubTests = otherTest.SubTests
                .Where(subTest => subTest.TankPosition == position)
                .OrderBy(subTest => NormalizeComparisonValue(subTest.TankName))
                .ToList();

            if (referenceSubTests.Count != otherSubTests.Count)
            {
                differences.Add(
                    $"TankPosition {position} — aantal tanks: " +
                    $"{referenceSubTests.Count} ≠ {otherSubTests.Count}");
                continue;
            }

            for (var i = 0; i < referenceSubTests.Count; i++)
            {
                var reference = referenceSubTests[i];
                var other = otherSubTests[i];

                AddDifference(differences, position, "TankName",
                    DisplayComparisonValue(reference.TankName),
                    DisplayComparisonValue(other.TankName));

                AddDifference(differences, position, "Min",
                    reference.Min.ToString(CultureInfo.CurrentCulture),
                    other.Min.ToString(CultureInfo.CurrentCulture));

                AddDifference(differences, position, "Max",
                    reference.Max.ToString(CultureInfo.CurrentCulture),
                    other.Max.ToString(CultureInfo.CurrentCulture));

                AddDifference(differences, position, "BlueMin",
                    reference.BlueMin.ToString(CultureInfo.CurrentCulture),
                    other.BlueMin.ToString(CultureInfo.CurrentCulture));

                AddDifference(differences, position, "BlueMax",
                    reference.BlueMax.ToString(CultureInfo.CurrentCulture),
                    other.BlueMax.ToString(CultureInfo.CurrentCulture));

                AddDifference(differences, position, "YellowMin",
                    reference.YellowMin.ToString(CultureInfo.CurrentCulture),
                    other.YellowMin.ToString(CultureInfo.CurrentCulture));

                AddDifference(differences, position, "YellowMax",
                    reference.YellowMax.ToString(CultureInfo.CurrentCulture),
                    other.YellowMax.ToString(CultureInfo.CurrentCulture));

                AddDifference(differences, position, "TolBlue",
                    reference.TolBlue.ToString(CultureInfo.CurrentCulture),
                    other.TolBlue.ToString(CultureInfo.CurrentCulture));

                AddDifference(differences, position, "ProcentMin",
                    DisplayComparisonValue(reference.ProcentMin),
                    DisplayComparisonValue(other.ProcentMin));

                AddDifference(differences, position, "ProcentMax",
                    DisplayComparisonValue(reference.ProcentMax),
                    DisplayComparisonValue(other.ProcentMax));

                AddDifference(differences, position, "ProcentText",
                    DisplayComparisonValue(reference.ProcentText),
                    DisplayComparisonValue(other.ProcentText));
            }
        }

        return differences;
    }

    private void AddDifference(
        List<string> differences,
        int position,
        string field,
        string referenceValue,
        string otherValue)
    {
        if (!string.Equals(referenceValue, otherValue, StringComparison.OrdinalIgnoreCase))
        {
            differences.Add(
                $"TankPosition {position} — {field}: " +
                $"{referenceValue} ≠ {otherValue}");
        }
    }

    private List<string> GetDistinctValues(IEnumerable<string?> values)
    {
        return values
            .Select(DisplayComparisonValue)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private string DisplayComparisonValue(string? value)
    {
        var normalized = NormalizeComparisonValue(value);
        return string.IsNullOrWhiteSpace(normalized) ? "-" : normalized;
    }

    private string GetInjectorComparisonName(TestResultViewModel injector)
    {
        var customerName = string.IsNullOrWhiteSpace(injector.Data.CustomerName)
            ? "-"
            : NormalizeComparisonValue(injector.Data.CustomerName);

        var dateTime = TimeZoneService.FormatForUser(
            injector.Data.TimeOffTesting,
            "dd-MM-yyyy HH:mm");

        return $"{customerName} - {dateTime}";
    }

    private string GetGeneralValidationTargetId(TestResultViewModel injector)
    {
        return $"comparison-general-injector-{GetInjectorTargetKey(injector)}";
    }

    private string GetValidationTargetId(int testId, TestResultViewModel injector)
    {
        return $"comparison-test-{testId}-injector-{GetInjectorTargetKey(injector)}";
    }

    private string GetInjectorTargetKey(TestResultViewModel injector)
    {
        var rawValue = !string.IsNullOrWhiteSpace(injector.Data.Id)
            ? injector.Data.Id
            : $"{injector.Data.CustomerName}-{injector.Data.TimeOffTesting:yyyyMMddHHmmssfff}";

        return System.Text.RegularExpressions.Regex.Replace(
            rawValue,
            @"[^a-zA-Z0-9_-]",
            "-");
    }

    private bool ComparisonValueEquals(string? first, string? second)
    {
        return string.Equals(
            NormalizeComparisonValue(first),
            NormalizeComparisonValue(second),
            StringComparison.OrdinalIgnoreCase);
    }

    private string NormalizeComparisonValue(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return string.Empty;

        var withoutHtml = System.Text.RegularExpressions.Regex.Replace(value, "<.*?>", " ");
        var decoded = System.Net.WebUtility.HtmlDecode(withoutHtml);

        return System.Text.RegularExpressions.Regex
            .Replace(decoded, @"\s+", " ")
            .Trim();
    }
}

<link rel="stylesheet" href="~/css/analysis.css" />

<div class="analysis-horizontal-scope">

    <div class="analysis-page-toolbar">
        <div class="analysis-page-toolbar-content">

            <h2 class="analysis-page-title">
                @Localizer["InjectorComparison"]
            </h2>

            <div class="analysis-top-controls">

                <form asp-controller="Analysis"
                      asp-action="GeneratePdf"
                      method="post"
                      class="analysis-pdf-form">

                    @foreach (var id in Model.SelectedIds)
                    {
                        <input type="hidden"
                               name="selectedIds"
                               value="@id" />
                    }

                    <select name="layoutMode"
                            id="layoutMode"
                            class="form-select">

                        @if (selectedLayoutMode == "Compact")
                        {
                            <option value="Compact" selected>
                                @Localizer["PDFOptionCompact"]
                            </option>
                        }
                        else
                        {
                            <option value="Compact">
                                @Localizer["PDFOptionCompact"]
                            </option>
                        }

                        @if (selectedLayoutMode == "KeepTestTogether")
                        {
                            <option value="KeepTestTogether" selected>
                                @Localizer["PDFOptionKeepTestTogether"]
                            </option>
                        }
                        else
                        {
                            <option value="KeepTestTogether">
                                @Localizer["PDFOptionKeepTestTogether"]
                            </option>
                        }

                        @if (selectedLayoutMode == "OneTestPerPage")
                        {
                            <option value="OneTestPerPage" selected>
                                @Localizer["PDFOptionOneTestPerPage"]
                            </option>
                        }
                        else
                        {
                            <option value="OneTestPerPage">
                                @Localizer["PDFOptionOneTestPerPage"]
                            </option>
                        }

                    </select>

                    <button type="submit"
                            class="btn btn-primary text-nowrap">
                        @Localizer["ButtonPDFDownload"]
                    </button>

                </form>

                @if (!comparisonValidation.IsValid)
                {
                    <div class="analysis-validation-toast analysis-validation-toast-warning"
                         role="alert">

                        <div class="analysis-validation-message">
                            <strong>
                                @Localizer["AnalysisValidationErrorTitle"]
                            </strong>

                            <small>
                                @Localizer["AnalysisValidationAccuracyWarning"]@Localizer["SymbolDot"]
                            </small>
                        </div>

                        <details class="analysis-validation-details">
                            <summary class="btn btn-sm btn-outline-warning text-nowrap">
                                @Localizer["AnalysisValidationShowDetails"]
                            </summary>

                            <div class="analysis-validation-details-panel">

                                <strong class="d-block mb-2">
                                    @Localizer["AnalysisValidationExactDifferences"]
                                </strong>

                                <ul class="mb-0 ps-4">
                                    @foreach (var detail in comparisonValidation.Details)
                                    {
                                        <li class="analysis-validation-detail-row">
                                            <span>@detail.Message</span>

                                            <a href="#@detail.TargetId"
                                               data-scroll-target="@detail.TargetId"
                                               class="btn btn-sm btn-outline-secondary text-nowrap analysis-validation-jump">
                                                @Localizer["AnalysisValidationGoToDifference"]
                                            </a>
                                        </li>
                                    }
                                </ul>

                            </div>
                        </details>

                    </div>
                }
                else
                {
                    <div class="analysis-validation-toast analysis-validation-toast-success"
                         role="status">

                        <div class="analysis-validation-message">
                            <strong>
                                @Localizer["AnalysisValidationSuccessTitle"]
                            </strong>

                            <small>
                                @Localizer["AnalysisValidationSuccess"]@Localizer["SymbolDot"]
                            </small>
                        </div>

                    </div>
                }

            </div>

        </div>
    </div>


    <table class="table table-bordered table-striped analysis-table">

        <thead>

            <!-- General information -->
            <tr id="comparison-general-info" class="info-row analysis-scroll-target">

                <th class="info-column">

                    <strong>
                        @Localizer["Injector"]:
                    </strong>

                    <br />

                    <small>
                        @Localizer["InjectorPartNumber"]:
                        @orderedInjectors.FirstOrDefault()?.Data.PartNumber
                    </small>

                    <br />

                    <small>
                        @Localizer["InjectorBrand"]:
                        @orderedInjectors.FirstOrDefault()?.Data.PartBrand
                    </small>

                    <br />

                    <small>
                        @Localizer["InjectorType"]:
                        @orderedInjectors.FirstOrDefault()?.Data.PartType
                    </small>

                    <br />

                </th>


                @foreach (var customerGroup in customerGroups)
                {
                    var customer = customerGroup.Injectors[0].Data;

                    <th class="info-column customer-segment-start"
                        colspan="@customerGroup.Injectors.Count">

                        <strong>
                            @Localizer["Customer"]:
                        </strong>

                        <br />

                        <small>
                            @Localizer["CustomerName"]:
                            @customer.CustomerName
                        </small>

                        <br />

                        @if (!string.IsNullOrWhiteSpace(customer.CustomerPhone))
                        {
                            <small>
                                @Localizer["CustomerPhoneNumber"]:
                                @customer.CustomerPhone
                            </small>
                        }

                        <br />

                        @if (!string.IsNullOrWhiteSpace(customer.CustomerMail))
                        {
                            <small>
                                @Localizer["CustomerMail"]:
                                @customer.CustomerMail
                            </small>
                        }

                        <br />

                        @if (!string.IsNullOrWhiteSpace(customer.CustomerNotes))
                        {
                            <small>
                                @Localizer["CustomerNote"]:
                                @customer.CustomerNotes
                            </small>
                        }

                        <br />

                    </th>
                }

            </tr>


            <!-- Injector information -->
            <tr>

                <th class="info-row">

                    <br />

                    <small>
                        @Localizer["InjectorTimeOffTesting"]:
                    </small>

                    <br />

                    <small>
                        @Localizer["InjectorSerialNumber"]:
                    </small>

                    <br />

                    <small>
                        @Localizer["InjectorNote"]:
                    </small>

                </th>


                @for (var injectorIndex = 0; injectorIndex < orderedInjectors.Count; injectorIndex++)
                {
                    var injector = orderedInjectors[injectorIndex];

                    var segmentClass =
                        customerSegmentStartIndexes.Contains(injectorIndex)
                            ? "customer-segment-start"
                            : "";

                    <th id="@GetGeneralValidationTargetId(injector)"
                        class="injector-info @segmentClass analysis-scroll-target">

                        <br />

                        <small>
                            @TimeZoneService.FormatForUser(
                                injector.Data.TimeOffTesting,
                                "dd-MM-yyyy HH:mm")
                        </small>

                        <br />

                        @if (!string.IsNullOrWhiteSpace(injector.Data.InjectorSerialNumber))
                        {
                            <small>
                                @injector.Data.InjectorSerialNumber
                            </small>
                        }

                        <br />

                        @if (!string.IsNullOrWhiteSpace(injector.Data.TestNotes))
                        {
                            <small>
                                @Html.Raw(injector.Data.TestNotes)
                            </small>
                        }

                    </th>
                }

            </tr>


            <!-- Test / tank header -->
            <tr>

                <th>

                    <br />
                    <br />

                    <div class="info-row">
                        @Localizer["TestTestNameAndTank"]
                    </div>

                </th>


                @for (var injectorIndex = 0; injectorIndex < orderedInjectors.Count; injectorIndex++)
                {
                    var segmentClass =
                        customerSegmentStartIndexes.Contains(injectorIndex)
                            ? "customer-segment-start"
                            : "";

                    <th class="@segmentClass"></th>
                }

            </tr>

        </thead>


        <tbody>

            @foreach (var test in displayTests)
            {
                var normalizedTest =
                    NormalizeTestName(test.TestName, groupTestsByBaseName);

                var injectorTests = orderedInjectors
                    .Select(injector =>
                        injector.NormalizedTests.FirstOrDefault(t =>
                            NormalizeTestName(t.TestName, groupTestsByBaseName) == normalizedTest))
                    .ToList();

                var hasAnyNonSkippedTest =
                    injectorTests.Any(t =>
                        t != null &&
                        !t.IsSkipped);

                var tankSubData = orderedInjectors
                    .SelectMany(injector => injector.Data.Tests)
                    .Where(t =>
                        NormalizeTestName(t.TestName, groupTestsByBaseName) == normalizedTest &&
                        t.TestStatus != 1)
                    .SelectMany(t => t.SubTests)
                    .GroupBy(t => t.TankName)
                    .Select(g => g.First())
                    .ToList();


                <!-- Test header -->
                <tr id="comparison-test-@test.TestId" class="test-header analysis-scroll-target">

                    <td>

                        <div>

                            <strong>
                                @normalizedTest
                            </strong>

                            <br />

                            <small>
                                @Localizer["TestType"]:
                                @(string.IsNullOrWhiteSpace(test.TestType)
                                    ? "-"
                                    : test.TestType)
                            </small>

                        </div>

                    </td>


                    @for (var injectorIndex = 0; injectorIndex < orderedInjectors.Count; injectorIndex++)
                    {
                        var injector = orderedInjectors[injectorIndex];

                        var segmentClass =
                            customerSegmentStartIndexes.Contains(injectorIndex)
                                ? "customer-segment-start"
                                : "";

                        var validationTargetId =
                            GetValidationTargetId(test.TestId, injector);

                        <td id="@validationTargetId"
                            class="@segmentClass analysis-scroll-target">
                        </td>
                    }

                </tr>


                @if (hasAnyNonSkippedTest)
                {
                    <tr class="tank-row">

                        <td>

                            <small>
                                @Localizer["TestResponseTime"]:
                            </small>

                        </td>


                        @for (var i = 0; i < injectorTests.Count; i++)
                        {
                            var injectorTest = injectorTests[i];

                            var segmentClass =
                                customerSegmentStartIndexes.Contains(i)
                                    ? "customer-segment-start"
                                    : "";

                            if (injectorTest == null ||
                                injectorTest.IsSkipped)
                            {
                                <td class="@segmentClass">
                                    -
                                </td>
                            }
                            else
                            {
                                <td class="@segmentClass">
                                    @injectorTest.Response @Localizer["SecondIndicator"]
                                </td>
                            }
                        }

                    </tr>
                }
                else
                {
                    <tr class="skipped-row">

                        <td></td>

                        @for (var i = 0; i < orderedInjectors.Count; i++)
                        {
                            var segmentClass =
                                customerSegmentStartIndexes.Contains(i)
                                    ? "customer-segment-start"
                                    : "";

                            <td class="skipped-cell @segmentClass">

                                <strong>
                                    @Localizer["TestSkipped"]
                                </strong>

                            </td>
                        }

                    </tr>
                }


                @if (hasAnyNonSkippedTest)
                {
                    <!-- Tank / result rows -->
                    @foreach (var tank in tankSubData)
                    {
                        <tr class="tank-row">

                            <!-- Tank information -->
                            <td>

                                @{
                                    var average =
                                        (tank.Min + tank.Max) / 2;

                                    var tolerance =
                                        average - tank.Min;
                                }

                                <strong>
                                    @tank.TankName
                                </strong>

                                <br />

                                <small>
                                    @Localizer["TestMin"]:
                                    @tank.Min
                                </small>

                                <br />

                                <small>
                                    @Localizer["TestMax"]:
                                    @tank.Max
                                </small>

                                <br />

                                <small>
                                    @Localizer["TestLimit"]:
                                    @average +/- @tolerance
                                </small>

                            </td>


                            <!-- Injector results -->
                            @for (var injectorIndex = 0; injectorIndex < orderedInjectors.Count; injectorIndex++)
                            {
                                var injector =
                                    orderedInjectors[injectorIndex];

                                var segmentClass =
                                    customerSegmentStartIndexes.Contains(injectorIndex)
                                        ? "customer-segment-start"
                                        : "";

                                var injectorTest =
                                    injector.NormalizedTests
                                        .FirstOrDefault(t =>
                                            NormalizeTestName(t.TestName, groupTestsByBaseName)
                                            == normalizedTest);

                                var actualTest = injector.Data.Tests
                                    .FirstOrDefault(t =>
                                        t.TestId == test.TestId);

                                var actualSub = actualTest?.SubTests
                                    .FirstOrDefault(s =>
                                        s.TankPosition == tank.TankPosition &&
                                        s.TankName == tank.TankName);

                                var sub = injector.Data.Tests
                                    .Where(t =>
                                        NormalizeTestName(t.TestName, groupTestsByBaseName)
                                        == normalizedTest)
                                    .SelectMany(t => t.SubTests)
                                    .FirstOrDefault(s =>
                                        s.TankName == tank.TankName);


                                if (injectorTest == null ||
                                    injectorTest.IsSkipped)
                                {
                                    <td class="skipped-cell @segmentClass">

                                        <div class="skipped-content">

                                            <strong>
                                                @Localizer["TestSkipped"]
                                            </strong>

                                        </div>

                                    </td>
                                }
                                else if (sub == null)
                                {
                                    <td class="skipped-cell @segmentClass">

                                        <div class="skipped-content">

                                            <strong>
                                                @Localizer["TestSkipped"]
                                            </strong>

                                        </div>

                                    </td>
                                }
                                else
                                {
                                    <td class="result-@sub.ResultColor @segmentClass">

                                        @if (showDebugInformation &&
                                             actualTest != null &&
                                             actualSub != null)
                                        {
                                            var debugAverage = (actualSub.Min + actualSub.Max) / 2;
                                            var debugTolerance = debugAverage - actualSub.Min;

                                            <div>
                                                <strong>DEBUG</strong><br />
                                                TestId: @actualTest.TestId<br />
                                                TestName: @actualTest.TestName<br />
                                                TestType: @actualTest.TestType<br />
                                                Tank: @actualSub.TankName<br />
                                                Position: @actualSub.TankPosition<br />
                                                Min: @actualSub.Min<br />
                                                Max: @actualSub.Max<br />
                                                Limit: @debugAverage +/- @debugTolerance<br />
                                                BlueMin: @actualSub.BlueMin<br />
                                                BlueMax: @actualSub.BlueMax<br />
                                                YellowMin: @actualSub.YellowMin<br />
                                                YellowMax: @actualSub.YellowMax<br />
                                                TolBlue: @actualSub.TolBlue<br />
                                                ProcentMin: @actualSub.ProcentMin<br />
                                                ProcentMax: @actualSub.ProcentMax<br />
                                                ProcentText: @actualSub.ProcentText
                                            </div>

                                            <hr />
                                        }

                                        @if (sub.Results == null ||
                                             sub.Results.Count == 0)
                                        {
                                            <strong>
                                                @Localizer["TestNoResults"]
                                            </strong>
                                        }
                                        else
                                        {
                                            var results =
                                                sub.Results;

                                            var resultMinCalculated =
                                                results.Min();

                                            var resultAverageCalculated =
                                                results.Average();

                                            var resultMaxCalculated =
                                                results.Max();


                                            <div>

                                                <strong>
                                                    @Localizer["TestMin"]:
                                                </strong>

                                                @resultMinCalculated
                                                @sub.ResultMin

                                            </div>


                                            <div>

                                                <strong>
                                                    @Localizer["TestAvg"]:
                                                </strong>

                                                @resultAverageCalculated.ToString("0.0")
                                                @sub.ResultAverage

                                            </div>


                                            <div>

                                                <strong>
                                                    @Localizer["TestMax"]:
                                                </strong>

                                                @resultMaxCalculated
                                                @sub.ResultMax

                                            </div>


                                            <br />


                                            <div>

                                                <strong>
                                                    @Localizer["TestResults"]:
                                                </strong>

                                                @string.Join(
                                                    " | ",
                                                    sub.Results
                                                )

                                            </div>
                                        }

                                    </td>
                                }
                            }

                        </tr>
                    }
                }
            }

        </tbody>

    </table>

</div>


<button type="button"
        id="backToLeftToast"
        class="back-to-left-toast"
        aria-label="@Localizer["ButtonBackToLeft"]">

    <span class="back-to-left-toast-icon">
        ←
    </span>

    <span class="back-to-left-toast-text">
        @Localizer["ButtonBackToLeft"]
    </span>

</button>


<button type="button"
        id="backToTopToast"
        class="back-to-top-toast"
        aria-label="@Localizer["ButtonBackToTop"]">

    <span class="back-to-top-toast-icon">
        ↑
    </span>

    <span class="back-to-top-toast-text">
        @Localizer["ButtonBackToTop"]
    </span>

</button>


<button type="button"
        id="backToStartToast"
        class="back-to-start-toast"
        aria-label="@Localizer["ButtonBackToStart"]">

    <span class="back-to-start-toast-icon">
        ↖
    </span>

    <span class="back-to-start-toast-text">
        @Localizer["ButtonBackToStart"]
    </span>

</button>


<script>
    document.addEventListener("DOMContentLoaded", function () {

        const validationDetails =
            document.querySelector(".analysis-validation-details");

        if (validationDetails) {
            document.addEventListener("click", function (event) {
                if (!validationDetails.open) {
                    return;
                }

                if (!validationDetails.contains(event.target)) {
                    validationDetails.removeAttribute("open");
                }
            });
        }


        function clearAnalysisHighlights() {
            const analysisTable =
                document.querySelector(".analysis-table");

            if (!analysisTable) {
                return;
            }

            analysisTable.classList.remove("analysis-has-highlight");

            analysisTable.querySelectorAll(
                ".analysis-highlight-row, .analysis-highlight-column, .analysis-highlight-target, .analysis-highlight-target-first, .analysis-highlight-target-last"
            ).forEach(element => {
                element.classList.remove(
                    "analysis-highlight-row",
                    "analysis-highlight-column",
                    "analysis-highlight-target",
                    "analysis-highlight-target-first",
                    "analysis-highlight-target-last"
                );
            });
        }


        function initializeValidationJumpButtons() {
            const validationJumpButtons =
                document.querySelectorAll(".analysis-validation-jump");

            validationJumpButtons.forEach(button => {
                button.addEventListener("click", function (event) {
                    event.preventDefault();

                    const targetId =
                        button.dataset.scrollTarget;

                    const target =
                        document.getElementById(targetId);

                    const analysisTable =
                        document.querySelector(".analysis-table");

                    if (!target || !analysisTable) {
                        return;
                    }

                    clearAnalysisHighlights();

                    const targetCell =
                        target.closest("td, th");

                    const targetRow =
                        target.closest("tr");

                    if (!targetCell || !targetRow) {
                        return;
                    }

                    const columnIndex =
                        targetCell.cellIndex;


                    /* Find first row of complete test */

                    let firstTestRow =
                        targetRow;

                    while (
                        firstTestRow.previousElementSibling &&
                        !firstTestRow.classList.contains("test-header")
                    ) {
                        firstTestRow =
                            firstTestRow.previousElementSibling;
                    }


                    /* Collect test title, response time and all tanks */

                    const testRows = [];
                    let currentRow =
                        firstTestRow;

                    while (currentRow) {
                        if (
                            currentRow !== firstTestRow &&
                            currentRow.classList.contains("test-header")
                        ) {
                            break;
                        }

                        testRows.push(currentRow);

                        currentRow =
                            currentRow.nextElementSibling;
                    }


                    /* Highlight complete logical test row */

                    testRows.forEach(row => {
                        row.querySelectorAll("td, th").forEach(cell => {
                            cell.classList.add("analysis-highlight-row");
                        });
                    });


                    /* Highlight complete injector column */

                    analysisTable.querySelectorAll("tr").forEach(row => {
                        const cell =
                            row.cells[columnIndex];

                        if (cell) {
                            cell.classList.add("analysis-highlight-column");
                        }
                    });


                    /* Highlight selected injector inside complete test */

                    const highlightedTargetCells = [];

                    testRows.forEach(row => {
                        const cell =
                            row.cells[columnIndex];

                        if (cell) {
                            cell.classList.add("analysis-highlight-target");
                            highlightedTargetCells.push(cell);
                        }
                    });

                    if (highlightedTargetCells.length > 0) {
                        highlightedTargetCells[0]
                            .classList.add("analysis-highlight-target-first");

                        highlightedTargetCells[
                            highlightedTargetCells.length - 1
                        ].classList.add("analysis-highlight-target-last");
                    }

                    analysisTable.classList.add("analysis-has-highlight");


                    /* Close details */

                    const details =
                        button.closest("details");

                    if (details) {
                        details.removeAttribute("open");
                    }


                    /* Scroll complete test to top */

                    const navbar =
                        document.querySelector("header");

                    const tableHeader =
                        analysisTable.querySelector("thead");

                    const navbarHeight =
                        navbar?.getBoundingClientRect().height ?? 0;

                    const tableHeaderHeight =
                        tableHeader?.getBoundingClientRect().height ?? 0;

                    const firstTestRect =
                        firstTestRow.getBoundingClientRect();

                    const targetRect =
                        targetCell.getBoundingClientRect();

                    const topOffset =
                        navbarHeight + tableHeaderHeight;

                    const scrollTop =
                        firstTestRect.top +
                        window.scrollY -
                        topOffset;

                    const scrollLeft =
                        targetRect.left +
                        window.scrollX -
                        (window.innerWidth / 2) +
                        (targetRect.width / 2);

                    window.scrollTo({
                        top: Math.max(0, scrollTop),
                        left: Math.max(0, scrollLeft),
                        behavior: "smooth"
                    });

                    window.history.replaceState(
                        {},
                        "",
                        `#${targetId}`
                    );
                });
            });
        }

        initializeValidationJumpButtons();


        const backToLeftToast =
            document.getElementById("backToLeftToast");

        if (backToLeftToast) {
            const updateBackToLeftToast = function () {
                backToLeftToast.classList.toggle(
                    "show",
                    window.scrollX > 100
                );
            };

            window.addEventListener(
                "scroll",
                updateBackToLeftToast,
                { passive: true }
            );

            backToLeftToast.addEventListener("click", function () {
                window.scrollTo({
                    left: 0,
                    top: window.scrollY,
                    behavior: "smooth"
                });
            });

            updateBackToLeftToast();
        }


        const backToTopToast =
            document.getElementById("backToTopToast");

        if (backToTopToast) {
            const updateBackToTopToast = function () {
                backToTopToast.classList.toggle(
                    "show",
                    window.scrollY > 250
                );
            };

            window.addEventListener(
                "scroll",
                updateBackToTopToast,
                { passive: true }
            );

            backToTopToast.addEventListener("click", function () {
                window.scrollTo({
                    left: window.scrollX,
                    top: 0,
                    behavior: "smooth"
                });
            });

            updateBackToTopToast();
        }


        const backToStartToast =
            document.getElementById("backToStartToast");

        if (backToStartToast) {
            const updateBackToStartToast = function () {
                backToStartToast.classList.toggle(
                    "show",
                    window.scrollX > 100 ||
                    window.scrollY > 250
                );
            };

            window.addEventListener(
                "scroll",
                updateBackToStartToast,
                { passive: true }
            );

            backToStartToast.addEventListener("click", function () {
                window.scrollTo({
                    left: 0,
                    top: 0,
                    behavior: "smooth"
                });
            });

            updateBackToStartToast();
        }


        const layoutSelect =
            document.getElementById("layoutMode");

        if (layoutSelect) {
            const storageKey =
                "analysisPdfLayoutMode";

            const savedLayout =
                sessionStorage.getItem(storageKey);

            if (savedLayout) {
                const optionExists =
                    Array.from(layoutSelect.options)
                        .some(option =>
                            option.value === savedLayout);

                if (optionExists) {
                    layoutSelect.value =
                        savedLayout;
                }
            }

            layoutSelect.addEventListener("change", function () {
                sessionStorage.setItem(
                    storageKey,
                    layoutSelect.value
                );

                const url =
                    new URL(window.location.href);

                url.searchParams.set(
                    "layoutMode",
                    layoutSelect.value
                );

                window.history.replaceState(
                    {},
                    "",
                    url
                );
            });
        }
    });
</script>